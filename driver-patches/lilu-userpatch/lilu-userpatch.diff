+__attribute__((noinline)) void UserPatcher::performModernPagePatch(void *vp, const void *data_ptr, size_t data_size) {
+	if (binaryModSize == 0 || !vp || !data_ptr || data_size == 0)
+		return;
+
+	char path[PATH_MAX];
+	int pathlen = PATH_MAX;
+	if (vn_getpath(static_cast<vnode_t>(vp), path, &pathlen) != 0)
+		return;
+
+	// Libraries residing in dyld shared cache do not exist on disk, their pages come from the cache files.
+	bool sharedCache = matchSharedCachePath(path);
+	const char *filePath = path;
+	static const char dataVolume[] = "/System/Volumes/Data/";
+	if (!sharedCache && !strncmp(path, dataVolume, sizeof(dataVolume) - 1))
+		filePath = path + sizeof(dataVolume) - 2;
+
+	for (size_t i = 0; i < binaryModSize; i++) {
+		auto mod = binaryMod[i];
+		if (!mod || !mod->path || !mod->patches)
+			continue;
+
+		if (sharedCache) {
+			if (strncmp(mod->path, "/System/Library/", strlen("/System/Library/")) &&
+				strncmp(mod->path, "/System/iOSSupport/", strlen("/System/iOSSupport/")) &&
+				strncmp(mod->path, "/usr/lib/", strlen("/usr/lib/")))
+				continue;
+		} else if (strcmp(filePath, mod->path)) {
+			continue;
+		}
+
+		for (size_t p = 0; p < mod->count; p++) {
+			auto &patch = mod->patches[p];
+			// Skip counting is file-wide and cannot be honoured per page, so such patches are not applied.
+			if (patch.section == ProcInfo::SectionDisabled || (patch.flags & LocalOnly) || patch.cpu != CPU_TYPE_X86_64 ||
+				patch.skip != 0 || patch.size == 0 || patch.size > data_size || !patch.find || !patch.replace)
+				continue;
+
+			if (UNLIKELY(KernelPatcher::findAndReplace(const_cast<void *>(data_ptr), data_size, patch.find, patch.size, patch.replace, patch.size)))
+				DBGLOG("user", "patched %s page with patch %lu of %s", path, p, mod->path);
+		}
+	}
+}
