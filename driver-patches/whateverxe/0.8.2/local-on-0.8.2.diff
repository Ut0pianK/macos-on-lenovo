+    IORegistryEntry::getRegistryRoot()->setProperty("WhateverXeNvSafari", nvSafari);
+    IORegistryEntry::getRegistryRoot()->setProperty("WhateverXeNvSafariLV", nvLvReady);
+    IORegistryEntry::getRegistryRoot()->setProperty("WhateverXeNvSafariMap", nvMapReady);
