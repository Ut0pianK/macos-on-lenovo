+static IOACPIPlatformDevice *wexTxhcAcpi() {
+	auto e = IORegistryEntry::fromPath("IOACPIPlane:/_SB/PC00@0/TXHC@d0000");
+	auto d = e ? static_cast<IOACPIPlatformDevice *>(e->metaCast("IOACPIPlatformDevice")) : nullptr;
+	if (!d && e) e->release();
