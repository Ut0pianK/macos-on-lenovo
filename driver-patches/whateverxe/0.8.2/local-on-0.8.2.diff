+	if (wexEpb >= 0 && wexEpb <= 15 && wexEpbSupported() && wexPmcPciScans == 1) { uint32_t w = (uint32_t)wexEpb; mp_rendezvous_no_intrs(wexEpbApply, &w); }
+}
+static bool wexPmcStatSerialize(void *, void *, OSSerialize *serializer) {
+	static uint64_t q[16 + 204 + 8 + 32 * 8];
