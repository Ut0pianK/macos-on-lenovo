+	const int nib = nid == 0x20 ? wexCoefNib(verb) : -1;
+	auto lk = wexHdaLock;                         // read once: the lock may be created while a call is in flight
+	if (lk) IOLockLock(lk);
+	if (nib == 0x5) wexCoefIdx = param;
+	else if (nib == 0x4) {
+		if (wexCtia && wexHpPresent) {
+			const uint16_t want = wexCoefIdx == 0x45 ? 0xD489 : wexCoefIdx == 0x1B ? 0x0C2B : param;
+			if (want != param) { param = want; verb = 0x4; __atomic_fetch_add(&wexCtiaRewritten, 1, __ATOMIC_RELAXED); }   // 4-bit form carries 16 bits
+		}
+		wexCoefIdx = 0xFFFF;
+	}
+	const auto r = FunctionCast(wexHdaFuncVerb, wexHdaOrgVerb)(that, nid, verb, param, output, waitForSuccess);
+	if (lk) IOLockUnlock(lk);
+	if (nid == 0x21 && verb == 0xF09 && output) {
+		const bool present = (*output & 0x80000000U) != 0;
+		if (present && !wexHpPresent) wexCtiaSchedule();
+		wexHpPresent = present;
+	}
+	if (pin) { if (wexDepopPost > 0) IOSleep(wexDepopClamp(wexDepopPost)); }
