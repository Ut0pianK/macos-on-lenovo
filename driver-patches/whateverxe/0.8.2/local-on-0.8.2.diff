+// Sink side, always from a driver thread that owns the AUX channel at that moment (its own DPCD 0x060 read, or right
+// after its own link training: a display wake retrains the link without reading 0x060, and the panel has forgotten 0x170).
+static void wexPsr1SinkEnable(void *port, uint32_t (*rd)(void *, uint32_t, void *, uint32_t), uint32_t (*wr)(void *, uint32_t, void *, uint32_t)) {
+	auto config = *reinterpret_cast<uint32_t **>(static_cast<uint8_t *>(port) + 0x548);
+	if (!config || config[0] != 0) return;
+	if (wexPsr1Cap == 0xFFFFFFFF) {
+		uint8_t cap[2] {};
