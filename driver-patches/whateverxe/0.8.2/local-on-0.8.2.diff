new file mode 100644
index 0000000..cf4b7cf
--- /dev/null
+++ b/WhateverXe/kern_bootseamless.hpp
@@ -0,0 +1,613 @@
+//
+//  kern_bootseamless.hpp  (-wex-bootseamless)
+//
+//  Tiger Lake boot -> WindowServer hand-off without a corrupted frame.
+//  WindowServer's first mode set re-programs pipe A plane 1 to the same GGTT surface (offset 0)
+//  with a new layout (linear 2240 stride -> X-tiled, 3072x1920 through the pipe scaler), so the
+//  firmware/console image is shown for a frame in the wrong layout. This module:
+//    arm()   at the first scanout setup of this boot: copies the visible linear image into pages
+//            mapped at an unused, scratch-backed GGTT range and points the (still linear) plane at
+//            the copy, so offset 0 is no longer on screen;
+//    write() at the driver's next PLANE_SURF write: redraws the same picture at offset 0 in the
+//            newly programmed layout (scaled so the pipe scaler maps it back to the same panel
+//            pixels), lets the write through, and later restores the borrowed GGTT entries.
+//  Any unexpected state aborts before the plane is touched; the fallback is clearing to black.
+//  Diagnostics: registry-root "WhateverXeBootSeamless" (stage, values).
+//
+
+#ifndef kern_bootseamless_hpp
+#define kern_bootseamless_hpp
+
+#include <Headers/kern_api.hpp>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/pci/IOPCIDevice.h>
+#include <kern/thread_call.h>
+
+namespace XeBootSeamless {
+using Read = uint32_t (*)(void *, unsigned long);
+using Write = void (*)(void *, unsigned long, uint32_t);
+
+enum : unsigned long {
+	PlaneCtl = 0x70180, PlaneStride = 0x70188, PlaneSize = 0x70190, PlaneSurf = 0x7019C,
+	PlaneSurfLive = 0x701AC, FrameCount = 0x70040, GgttFlush = 0x101008,
+};
+
+struct State {
+	int flag {-1};
+	bool done, armed;
+	volatile bool hiding; // plane may point at the copy; hide that address from the driver
+	void *access;
+	Read rd; Write wr;
+	IOMemoryMap *gsm, *ap;
+	IOBufferMemoryDescriptor *buf;
+	IOMemoryMap *bufMap;
+	uint32_t *src;
+	size_t srcBytes;
+	uint32_t w0, h0, stride0, surf0Flags;
+	uint32_t run, pages;
+	uint64_t *saved;
+	thread_call_t cleanup, poll;
+	uint32_t copyPages, holdOff, polls, holdW, holdH, holdBytes, waitedFor;
+	volatile bool holding;
+	volatile uint32_t lastReq;
+	volatile uint64_t releaseNs; // when the held boot picture was handed to WindowServer // WindowServer's latest requested PLANE_SURF while holding
+	uint32_t gsmEntries;
+	bool zeroLinear;
+	uint64_t log[40];
+	uint32_t bx0, by0, bx1, by1; // bounding box of the lit boot picture (held coordinates)
+	uint32_t heldCtl, heldColor, pendCtl, pendColor, diffCtl, diffColor;
+	bool havePendCtl, havePendColor;
+};
+static State s;
+
+static inline uint64_t nowNs() { uint64_t t = 0, n = 0; clock_get_uptime(&t); absolutetime_to_nanoseconds(t, &n); return n; }
+static void publish(uint64_t stage) {
+	s.log[0] = stage; s.log[1] = nowNs();
+	IORegistryEntry::getRegistryRoot()->setProperty("WhateverXeBootSeamless", s.log, sizeof(s.log));
+}
+static bool waitFrames(uint32_t n) {
+	const auto start = s.rd(s.access, FrameCount);
+	for (int i = 0; i < 400; i++) { // <= 200 ms
+		if (static_cast<uint32_t>(s.rd(s.access, FrameCount) - start) >= n) return true;
+		IODelay(500);
+	}
+	return false;
+}
+static volatile uint64_t *pte(uint32_t i) { return reinterpret_cast<volatile uint64_t *>(s.gsm->getVirtualAddress()) + i; }
+static inline bool isCopy(uint32_t v) { const uint32_t b = v & ~0xFFFU; return s.run && b >= s.run * 4096U && b < (s.run + s.pages) * 4096U; }
+static void flushGgtt() { s.wr(s.access, GgttFlush, 1); (void)s.rd(s.access, GgttFlush); }
+
+static void release() {
+	if (s.bufMap) { s.bufMap->release(); s.bufMap = nullptr; }
+	if (s.buf) { s.buf->complete(); s.buf->release(); s.buf = nullptr; }
+	if (s.src) { IOFree(s.src, s.srcBytes); s.src = nullptr; }
+	if (s.saved) { IOFree(s.saved, s.pages * sizeof(uint64_t)); s.saved = nullptr; }
+	if (s.ap) { s.ap->release(); s.ap = nullptr; }
+	if (s.gsm) { s.gsm->release(); s.gsm = nullptr; }
+}
+static void restorePtes() {
+	// Put back only entries that still hold our page; anything the driver mapped meanwhile stays.
+	uint32_t skipped = 0;
+	for (uint32_t i = 0; i < s.pages; i++) {
+		IOByteCount len = 0;
+		const auto phys = s.buf ? s.buf->getPhysicalSegment(i * 4096ULL, &len, kIOMemoryMapperNone) : 0;
+		if (phys && *pte(s.run + i) == (phys | 1)) *pte(s.run + i) = s.saved[i]; else skipped++;
+	}
+	s.log[10] = skipped;
+	(void)*pte(s.run);
+	flushGgtt();
+}
+static void clearBlack(size_t bytes) {
+	if (!s.ap) return;
+	if (bytes > s.ap->getLength()) bytes = s.ap->getLength();
+	auto p = reinterpret_cast<volatile uint64_t *>(s.ap->getVirtualAddress());
+	for (size_t i = 0; i < bytes / 8; i++) p[i] = 0;
+}
+
+// Runs from a thread call well after the driver's own surface has latched.
+static void cleanupCall(thread_call_param_t, thread_call_param_t) {
+	if (s.holding) return; // the poll releases first and re-schedules us
+	const auto live = s.rd(s.access, PlaneSurfLive);
+	if (isCopy(live)) { s.log[10] = live; publish(90); return; } // still on borrowed pages: leak, never unmap in use
+	restorePtes();
+	if (s.log[10]) { publish(95); return; } // keep pages alive if anything unexpected happened
+	release();
+	s.armed = false;
+	s.hiding = false;
+	publish(100);
+}
+
+static void scheduleIn(thread_call_t call, uint32_t ms) {
+	uint64_t deadline = 0; clock_interval_to_deadline(ms, kMillisecondScale, &deadline); thread_call_enter_delayed(call, deadline);
+}
+// Hand the plane back to the driver's own surface (offset 0) and clean up shortly after.
+static void releaseHold(uint32_t why) {
+	if (!s.holding) return;
+	s.holding = false;
+	s.releaseNs = nowNs();
+	if (s.havePendCtl) s.wr(s.access, PlaneCtl, s.pendCtl);
+	if (s.havePendColor) s.wr(s.access, 0x701CC, s.pendColor);
+	s.log[28] = s.heldCtl; s.log[29] = s.pendCtl; s.log[30] = s.heldColor; s.log[31] = (static_cast<uint64_t>(s.diffCtl) << 48) | (static_cast<uint64_t>(s.diffColor) << 32) | s.pendColor;
+	const auto cur = s.rd(s.access, PlaneSurf);
+	if (isCopy(cur)) s.wr(s.access, PlaneSurf, s.lastReq ? s.lastReq : (cur & 0xFFFU));
+	s.log[22] = why; s.log[23] = s.polls;
+	publish(40);
+	if (s.cleanup) scheduleIn(s.cleanup, 150);
+}
+// Count non-black samples in WindowServer's latest surface. Surfaces above the CPU aperture are
+// read through their GGTT entries (physical pages), any tiling: only "is anything lit" matters.
+static uint32_t litSamples(uint32_t surf) {
+	const uint32_t base = surf & ~0xFFFU;
+	if (!base) {
+		auto p = reinterpret_cast<volatile uint8_t *>(s.ap->getVirtualAddress());
+		uint32_t lit = 0;
+		for (uint32_t gy = 1; gy < 16; gy++) for (uint32_t gx = 1; gx < 16; gx++) {
+			const uint32_t x = s.holdW * gx / 16, y = s.holdH * gy / 16;
+			const size_t off = s.zeroLinear ? static_cast<size_t>(y) * s.holdBytes + x * 4 :
+				(static_cast<size_t>(y / 8) * (s.holdBytes / 512) + x / 128) * 4096 + (y % 8) * 512 + (x % 128) * 4;
+			if (*reinterpret_cast<volatile uint32_t *>(p + off) & 0x00E0E0E0U) lit++;
+		}
+		return lit;
+	}
+	const uint32_t pages = static_cast<uint32_t>(static_cast<uint64_t>(s.holdBytes) * s.holdH / 4096);
+	uint32_t lit = 0;
+	for (uint32_t k = 0; k < 64; k++) {
+		const uint32_t idx = base / 4096 + k * pages / 64;
+		if (idx >= s.gsmEntries) break;
+		const uint64_t e = *pte(idx);
+		if (!(e & 1)) continue;
+		auto md = IOMemoryDescriptor::withPhysicalAddress(e & 0x7FFFFFF000ULL, 4096, kIODirectionIn);
+		if (!md) continue;
+		if (auto map = md->createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapReadOnly)) {
+			auto w = reinterpret_cast<volatile uint32_t *>(map->getVirtualAddress());
+			for (uint32_t i = 0; i < 1024; i += 16) if (w[i] & 0x00E0E0E0U) lit++;
+			map->release();
+		}
+		md->release();
+	}
+	return lit;
+}
+// WindowServer's surface format follows its own PLANE_CTL (deferred while holding): decode to 8-bit RGB.
+static inline uint32_t toRGB8(uint32_t v, uint32_t ctl) {
+	if (((ctl >> 23) & 0x1F) == 4) // x:R:G:B 2:10:10:10
+		return (((v >> 22) & 0xFF) << 16) | (((v >> 12) & 0xFF) << 8) | ((v >> 2) & 0xFF);
+	return v & 0xFFFFFF;
+}
+static inline bool near(uint32_t a, uint32_t b, int tol) {
+	for (int c = 0; c < 24; c += 8) { const int x = (a >> c) & 0xFF, y = (b >> c) & 0xFF; if (x - y > tol || y - x > tol) return false; }
+	return true;
+}
+// Sample WindowServer's latest surface and the held picture at the same X-tiled offsets.
+struct PageCache { uint32_t idx = ~0U; IOMemoryDescriptor *md = nullptr; IOMemoryMap *map = nullptr; volatile uint8_t *p = nullptr;
+	void drop() { if (map) map->release(); if (md) md->release(); map = nullptr; md = nullptr; p = nullptr; }
+	volatile uint8_t *get(uint32_t i) {
+		if (i == idx) return p;
+		drop(); idx = i;
+		if (i >= s.gsmEntries) return nullptr;
+		const uint64_t e = *pte(i);
+		if (!(e & 1)) return nullptr;
+		md = IOMemoryDescriptor::withPhysicalAddress(e & 0x7FFFFFF000ULL, 4096, kIODirectionIn);
+		if (md) map = md->createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapReadOnly);
+		if (map) p = reinterpret_cast<volatile uint8_t *>(map->getVirtualAddress());
+		return p;
+	} };
+static uint32_t matchLit, heldLit, matchAll, samples, fineN, fineBad, fineSum, lastFineSum, stable, goodPolls;
+static uint32_t coarsePolls;
+static void compare(uint32_t surf, bool &coarse, bool &fine) {
+	coarse = fine = false;
+	const uint32_t base = surf & ~0xFFFU;
+	if (!base) return;
+	const uint32_t wsCtl = s.havePendCtl ? s.pendCtl : s.heldCtl;
+	auto held = reinterpret_cast<volatile uint8_t *>(s.bufMap->getVirtualAddress()) + s.copyPages * 4096ULL;
+	const uint32_t tilesPerRow = s.holdBytes / 512;
+	PageCache pc;
+	auto sample = [&](uint32_t x, uint32_t y, uint32_t &ws, uint32_t &hp) -> bool {
+		const size_t off = (static_cast<size_t>(y / 8) * tilesPerRow + x / 128) * 4096 + (y % 8) * 512 + (x % 128) * 4;
+		auto pg = pc.get(base / 4096 + static_cast<uint32_t>(off / 4096));
+		if (!pg) return false;
+		ws = toRGB8(*reinterpret_cast<volatile uint32_t *>(pg + off % 4096), wsCtl);
+		hp = *reinterpret_cast<volatile uint32_t *>(held + off) & 0xFFFFFF;
+		return true;
+	};
+	matchLit = heldLit = matchAll = samples = 0;
+	for (uint32_t gy = 1; gy < 40; gy++) for (uint32_t gx = 1; gx < 40; gx++) {
+		uint32_t ws, hp;
+		if (!sample(s.holdW * gx / 40, s.holdH * gy / 40, ws, hp)) continue;
+		samples++;
+		const bool close = near(ws, hp, 0x30);
+		if (close) matchAll++;
+		if (hp & 0xC0C0C0) { heldLit++; if (close) matchLit++; }
+	}
+	coarse = samples > 1000 && heldLit > 8 && matchLit * 10 >= heldLit * 9 && matchAll * 100 >= samples * 97;
+	// Fine pass over the lit area: anti-aliased edges included.
+	fineN = fineBad = fineSum = 0;
+	if (s.bx1 > s.bx0 && s.by1 > s.by0) {
+		const uint64_t area = static_cast<uint64_t>(s.bx1 - s.bx0) * (s.by1 - s.by0);
+		uint32_t step = 1; while (area / (static_cast<uint64_t>(step) * step) > 8000) step++;
+		for (uint32_t y = s.by0; y < s.by1; y += step) for (uint32_t x = s.bx0; x < s.bx1; x += step) {
+			uint32_t ws, hp;
+			if (!sample(x, y, ws, hp)) continue;
+			fineN++; fineSum += ws * 2654435761U + x;
+			if (!near(ws, hp, 0x18)) fineBad++;
+		}
+	}
+	pc.drop();
+	fine = fineN > 100 && fineBad * 200 <= fineN; // at most 0.5% of the lit area differs
+}
+// Hold the boot picture until WindowServer shows the same picture: exactly (two polls in a row), or
+// complete and no longer changing (three polls) when its logo inherently differs; at most 4 s.
+static void pollCall(thread_call_param_t, thread_call_param_t) {
+	if (!s.holding) return;
+	s.polls++;
+	const auto req = s.lastReq;
+	bool coarse, fine;
+	compare(req, coarse, fine);
+	goodPolls = coarse && fine ? goodPolls + 1 : 0;
+	stable = coarse && fineSum == lastFineSum ? stable + 1 : 0;
+	coarsePolls = coarse ? coarsePolls + 1 : 0;
+	lastFineSum = fineSum;
+	s.log[19] = req;
+	s.log[21] = (static_cast<uint64_t>(matchLit) << 48) | (static_cast<uint64_t>(heldLit) << 32) | (static_cast<uint64_t>(matchAll) << 16) | samples;
+	s.log[33] = (static_cast<uint64_t>(fineBad) << 32) | fineN; s.log[34] = (static_cast<uint64_t>(goodPolls) << 32) | stable;
+	if (goodPolls >= 2) { releaseHold(1); return; }
+	if (stable >= 3) { releaseHold(5); return; }
+	if (coarsePolls >= 8) { releaseHold(6); return; } // matches overall for 0.4 s: inherent fine differences
+	if (s.polls >= 80) { releaseHold(2); return; }
+	scheduleIn(s.poll, 50);
+}
+// First scanout setup of this boot (WindowServer's first mode set), before any plane write.
+static void arm(IOPCIDevice *pci, void *access, mach_vm_address_t readFn, mach_vm_address_t writeFn) {
+	if (s.flag < 0) s.flag = checkKernelArgument("-wex-bootseamless") ? 1 : 0;
+	if (s.flag != 1 || s.done) return;
+	s.done = true;
+	if (nowNs() > 60000000000ULL || !pci || !access || !readFn || !writeFn) { publish(1); return; }
+	s.access = access; s.rd = reinterpret_cast<Read>(readFn); s.wr = reinterpret_cast<Write>(writeFn);
+	auto bar0 = pci->getDeviceMemoryWithRegister(0x10), bar2 = pci->getDeviceMemoryWithRegister(0x18);
+	if (!bar0 || !bar2 || bar0->getLength() < 16U * 1024 * 1024) { publish(2); return; }
+	const uint32_t entries = static_cast<uint32_t>(bar2->getLength() / 4096);
+	s.ap = bar2->createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapWriteCombineCache, 0, 48U * 1024 * 1024);
+	if (!s.ap) { publish(3); return; }
+	const auto ctl = s.rd(access, PlaneCtl), stride = s.rd(access, PlaneStride), size = s.rd(access, PlaneSize);
+	const auto surf = s.rd(access, PlaneSurf), live = s.rd(access, PlaneSurfLive);
+	s.log[2] = ctl; s.log[3] = stride; s.log[4] = size; s.log[5] = surf; s.log[6] = live;
+	s.w0 = (size & 0x1FFF) + 1; s.h0 = ((size >> 16) & 0x1FFF) + 1; s.stride0 = (stride & 0x7FF) * 64;
+	s.surf0Flags = surf & 0xFFF;
+	s.log[10] = s.rd(access, 0x68180); // pipe A scaler 1 control at hand-off
+	// Expect the firmware plane: enabled, linear, at GGTT 0, sane geometry.
+	if ((s.log[10] & 0x80000000U) || !(ctl & 0x80000000U) || (ctl & 0x1C00) || (surf & ~0xFFFU) || (live & ~0xFFFU) ||
+		s.w0 < 640 || s.h0 < 400 || s.w0 * 4 > s.stride0 || s.h0 > 4096) { publish(4); clearBlack(40U << 20); release(); return; }
+	s.srcBytes = static_cast<size_t>(s.stride0) * s.h0;
+	s.copyPages = static_cast<uint32_t>(((s.srcBytes + 0x3FFFF) & ~static_cast<size_t>(0x3FFFF)) / 4096);
+	s.pages = s.copyPages + 10240; // + 40 MB for the held picture in the new layout (3840x2400 fits)
+	s.gsmEntries = static_cast<uint32_t>((bar0->getLength() - 8U * 1024 * 1024) / 8);
+	s.gsm = bar0->createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapInhibitCache, 8U * 1024 * 1024, s.gsmEntries * 8ULL);
+	if (!s.gsm) { publish(5); clearBlack(40U << 20); release(); return; }
+	// Unused GGTT entries all point at the same scratch page; take the highest aligned run of them
+	// above 64 MB whose value equals the last aperture entry.
+	const auto scratch = *pte(entries - 1);
+	uint32_t found = 0;
+	for (uint32_t start = (entries - s.pages) & ~63U; start >= 16384 && !found; start -= 64) {
+		bool ok = true;
+		for (uint32_t i = 0; i < s.pages && ok; i++) ok = *pte(start + i) == scratch;
+		if (ok) found = start;
+		if (start < 64) break;
+	}
+	s.log[7] = scratch; s.log[8] = found;
+	if (!found || !(*pte(0) & 1)) { publish(6); clearBlack(40U << 20); release(); return; }
+	s.run = found;
+	s.holdOff = (found + s.copyPages) * 4096U;
+	s.buf = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task, kIODirectionInOut, s.pages * 4096ULL, 0x0000007FFFFFF000ULL);
+	s.src = static_cast<uint32_t *>(IOMalloc(s.srcBytes));
+	s.saved = static_cast<uint64_t *>(IOMalloc(s.pages * sizeof(uint64_t)));
+	if (!s.buf || !s.src || !s.saved || s.buf->prepare() != kIOReturnSuccess) { if (s.buf) { s.buf->release(); s.buf = nullptr; } publish(7); clearBlack(40U << 20); release(); return; }
+	s.bufMap = s.buf->createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapWriteCombineCache);
+	if (!s.bufMap) { publish(8); clearBlack(40U << 20); release(); return; }
+	// Visible image -> cached source copy -> scanout copy in our pages.
+	// The driver may already have put an X fence over offset 0: CPU reads through the aperture are
+	// then de-tiled by the hardware. The firmware image is linear in memory, so read each 512-byte
+	// run from the CPU address the fence maps onto that memory offset.
+	uint32_t fencePitch = 0;
+	for (uint32_t i = 0; i < 32; i++) {
+		const auto lo = s.rd(access, 0x100000 + i * 8), hi = s.rd(access, 0x100004 + i * 8);
+		if (!(lo & 1) || (lo & ~0xFFFU) != 0) continue;
+		if (lo & 2) { fencePitch = 1; break; } // Y fence: not handled
+		fencePitch = ((hi & 0xFFF) + 1) * 128; s.log[25] = lo; s.log[26] = hi; break;
+	}
+	s.log[24] = fencePitch;
+	if (fencePitch == 1 || (fencePitch && fencePitch % 512)) { publish(11); clearBlack(40U << 20); release(); return; }
+	auto ap = reinterpret_cast<const volatile uint8_t *>(s.ap->getVirtualAddress());
+	auto to = reinterpret_cast<uint64_t *>(s.src);
+	if (!fencePitch) {
+		auto from = reinterpret_cast<const volatile uint64_t *>(ap);
+		for (size_t i = 0; i < s.srcBytes / 8; i++) to[i] = from[i];
+	} else {
+		const size_t rowBytes = static_cast<size_t>(fencePitch) * 8; // one row of X tiles
+		for (size_t m = 0; m < s.srcBytes; m += 512) {
+			const size_t ty = m / rowBytes, inRow = m % rowBytes, tx = inRow / 4096, r = (inRow % 4096) / 512;
+			const size_t a = (ty * 8 + r) * fencePitch + tx * 512;
+			auto from = reinterpret_cast<const volatile uint64_t *>(ap + a);
+			for (size_t k = 0; k < 64; k++) to[m / 8 + k] = from[k];
+		}
+	}
+	auto copy = reinterpret_cast<volatile uint64_t *>(s.bufMap->getVirtualAddress());
+	for (size_t i = 0; i < s.srcBytes / 8; i++) copy[i] = to[i];
+	// Borrow the scratch entries.
+	for (uint32_t i = 0; i < s.pages; i++) {
+		IOByteCount len = 0;
+		const auto phys = s.buf->getPhysicalSegment(i * 4096ULL, &len, kIOMemoryMapperNone);
+		if (!phys || (phys & 0xFFF)) { for (uint32_t j = 0; j < i; j++) *pte(s.run + j) = s.saved[j]; flushGgtt(); publish(9); clearBlack(40U << 20); release(); return; }
+		s.saved[i] = *pte(s.run + i);
+		*pte(s.run + i) = phys | 1;
+	}
+	(void)*pte(s.run);
+	flushGgtt();
+	// Point the still-linear plane at the copy; nothing else in the plane changes.
+	s.wr(access, PlaneSurf, s.run * 4096U | s.surf0Flags);
+	waitFrames(2);
+	const auto now = s.rd(access, PlaneSurfLive) & ~0xFFFU;
+	s.log[9] = now;
+	if (now != s.run * 4096U) {
+		s.wr(access, PlaneSurf, s.surf0Flags);
+		waitFrames(2);
+		restorePtes(); publish(10); clearBlack(40U << 20); release(); return;
+	}
+	s.cleanup = thread_call_allocate(cleanupCall, nullptr);
+	s.poll = thread_call_allocate(pollCall, nullptr);
+	s.hiding = true;
+	s.armed = true;
+	publish(20);
+}
+
+// Called for every native register write before it is forwarded.
+// The driver reprograms PLANE_SURF from what it reads back; never let it keep the copy's address.
+static inline uint32_t hideRead(void *access, unsigned long reg, uint32_t v) {
+	if (s.hiding && access == s.access && (reg == PlaneSurf || reg == PlaneSurfLive) && isCopy(v))
+		return s.holding && s.lastReq ? s.lastReq : (v & 0xFFFU);
+	return v;
+}
+static void renderAt(volatile uint8_t *base, uint32_t w, uint32_t h, uint32_t bytes, uint32_t tiling) {
+	if (tiling == 0) {
+		for (uint32_t y = 0; y < h; y++) {
+			auto row = reinterpret_cast<volatile uint32_t *>(base + static_cast<size_t>(y) * bytes);
+			const auto srow = s.src + static_cast<uint64_t>(y) * s.h0 / h * (s.stride0 / 4);
+			for (uint32_t x = 0; x < w; x++) row[x] = srow[static_cast<uint64_t>(x) * s.w0 / w];
+		}
+		return;
+	}
+	// X tile: 512 bytes x 8 rows, row-major inside the tile; no bit-6 swizzle on gen12.
+	const uint32_t tilesPerRow = bytes / 512;
+	for (uint32_t y = 0; y < h; y++) {
+		const auto srow = s.src + static_cast<uint64_t>(y) * s.h0 / h * (s.stride0 / 4);
+		const size_t rowBase = static_cast<size_t>(y / 8) * tilesPerRow * 4096 + (y % 8) * 512;
+		for (uint32_t tx = 0; tx * 128 < w; tx++) {
+			auto t = reinterpret_cast<volatile uint32_t *>(base + rowBase + static_cast<size_t>(tx) * 4096);
+			for (uint32_t c = 0; c < 128 && tx * 128 + c < w; c++)
+				t[c] = srow[static_cast<uint64_t>(tx * 128 + c) * s.w0 / w];
+		}
+	}
+}
+static void render(uint32_t dst, uint32_t w, uint32_t h, uint32_t bytes, uint32_t tiling) {
+	renderAt(reinterpret_cast<volatile uint8_t *>(s.ap->getVirtualAddress()) + dst, w, h, bytes, tiling);
+}
+static inline bool fits(uint32_t dst, uint32_t w, uint32_t h, uint32_t bytes, uint32_t tiling) {
+	return (tiling == 0 || tiling == 1) && w && h && w * 4 <= bytes && h <= 4096 &&
+		dst + static_cast<uint64_t>(bytes) * h <= s.ap->getLength();
+}
+static uint32_t preW, preH, preBytes, preTiling; static bool pre;
+
+// CPU access through the aperture goes through fence registers: if the driver has a fence over the
+// surface, the hardware already tiles CPU writes, so the picture must be written in linear order
+// with the fence pitch. Gen6+ layout: lo[31:12] start, lo[1] Y, lo[0] valid; hi[11:0] pitch/128-1,
+// hi[31:12] last page.
+static uint32_t effectiveTiling(uint32_t dst, uint32_t size, uint32_t tiling, uint32_t &bytes) {
+	for (uint32_t i = 0; i < 32; i++) {
+		const auto lo = s.rd(s.access, 0x100000 + i * 8), hi = s.rd(s.access, 0x100004 + i * 8);
+		if (!(lo & 1)) continue;
+		const uint32_t start = lo & ~0xFFFU, last = hi & ~0xFFFU, pitch = ((hi & 0xFFF) + 1) * 128;
+		if (dst + size <= start || dst > last) continue;
+		s.log[16] = i; s.log[17] = lo; s.log[18] = hi;
+		if (!(lo & 2) && pitch == bytes && dst >= start && dst + size <= last + 4096) return 0; // X fence: write linear
+		s.log[19] = 0xBAD; return 7; // a fence we cannot honour
+	}
+	return tiling;
+}
+
+static void write(void *access, unsigned long reg, uint32_t &value) {
+	if (!s.hiding || access != s.access) return;
+	// Pre-render at the driver's first new PLANE_CTL (stride is already programmed), so the
+	// PLANE_SURF write later is not delayed past the vblank that latches the pipe scaler.
+	if (reg == 0x701CC) {
+		if (s.holding && value != s.heldColor) { s.pendColor = value; s.havePendColor = true; s.diffColor++; value = s.heldColor; }
+		return;
+	}
+	if (reg == PlaneCtl || reg == PlaneStride || reg == PlaneSize) {
+		// A different layout while holding: the held picture no longer matches, let go.
+		if (s.holding && reg == PlaneCtl && ((value >> 10) & 7) != 1) releaseHold(3);
+		// Same layout but another format/colour setting for WindowServer's surface: defer it.
+		else if (s.holding && reg == PlaneCtl && value != s.heldCtl) { s.pendCtl = value; s.havePendCtl = true; s.diffCtl++; value = s.heldCtl; return; }
+		if (s.holding && reg == PlaneSize && value != (((s.holdH - 1) << 16) | (s.holdW - 1))) releaseHold(4);
+		if (reg != PlaneCtl || !s.armed || pre) return;
+		const uint32_t tiling = (value >> 10) & 7, stride = s.rd(s.access, PlaneStride) & 0x7FF;
+		if (tiling != 1 || !stride) return;
+		const uint32_t bytes = stride * 512;
+		uint32_t w, h;
+		if ((s.w0 * 4 + 511) / 512 == stride) { w = s.w0; h = s.h0; } // native-size HiDPI, no scaler
+		else {
+			w = stride * 128;
+			if ((static_cast<uint64_t>(w) * s.h0) % s.w0) return;
+			h = static_cast<uint32_t>(static_cast<uint64_t>(w) * s.h0 / s.w0);
+		}
+		if (static_cast<uint64_t>(bytes) * h > 10240ULL * 4096 || w * 4 > bytes || h > 4096) return;
+		// Held picture: our own pages, no fence, write the X tiles directly.
+		renderAt(reinterpret_cast<volatile uint8_t *>(s.bufMap->getVirtualAddress()) + s.copyPages * 4096ULL, w, h, bytes, 1);
+		// WindowServer's surface starts black so its first real content can be detected.
+		uint32_t b = bytes;
+		s.zeroLinear = effectiveTiling(0, bytes * h, 1, b) == 0;
+		clearBlack(static_cast<size_t>(bytes) * h);
+		{
+			uint32_t x0 = s.w0, y0 = s.h0, x1 = 0, y1 = 0;
+			for (uint32_t y = 0; y < s.h0; y += 2) {
+				const auto row = s.src + static_cast<size_t>(y) * (s.stride0 / 4);
+				for (uint32_t x = 0; x < s.w0; x += 2) if (row[x] & 0xC0C0C0) {
+					if (x < x0) x0 = x; if (x > x1) x1 = x; if (y < y0) y0 = y; if (y > y1) y1 = y;
+				}
+			}
+			if (x1 > x0 && y1 > y0) {
+				const auto pad = 8U;
+				s.bx0 = (x0 > pad ? x0 - pad : 0) * w / s.w0; s.by0 = (y0 > pad ? y0 - pad : 0) * h / s.h0;
+				s.bx1 = (x1 + pad < s.w0 ? x1 + pad : s.w0) * w / s.w0; s.by1 = (y1 + pad < s.h0 ? y1 + pad : s.h0) * h / s.h0;
+			}
+			s.log[32] = (static_cast<uint64_t>(s.bx0) << 48) | (static_cast<uint64_t>(s.by0) << 32) | (static_cast<uint64_t>(s.bx1) << 16) | s.by1;
+		}
+		preW = w; preH = h; preBytes = bytes; preTiling = tiling; pre = true;
+		s.holdW = w; s.holdH = h; s.holdBytes = bytes;
+		s.log[15] = 4; s.log[20] = s.zeroLinear ? 1 : 2;
+		publish(25);
+		return;
+	}
+	if (reg != PlaneSurf) return;
+	if (isCopy(value)) value &= 0xFFFU;
+	// While holding, every flip of the driver's surface shows the held picture instead.
+	if (s.holding) { s.lastReq = value; value = s.holdOff | (value & 0xFFFU); return; }
+	if (!s.armed) return;
+	s.armed = false;
+	const auto ctl = s.rd(s.access, PlaneCtl), stride = s.rd(s.access, PlaneStride), size = s.rd(s.access, PlaneSize);
+	const uint32_t w = (size & 0x1FFF) + 1, h = ((size >> 16) & 0x1FFF) + 1, tiling = (ctl >> 10) & 7;
+	const uint32_t dst = value & ~0xFFFU;
+	s.log[11] = ctl; s.log[12] = stride; s.log[13] = size; s.log[14] = value;
+	const uint32_t bytes = (stride & 0x7FF) * (tiling == 1 ? 512U : 64U);
+	if (pre && dst == 0 && w == preW && h == preH && bytes == preBytes && tiling == preTiling) {
+		s.log[15] = 5; // held picture matches the programmed mode: show it until WindowServer draws
+		s.lastReq = value;
+		value = s.holdOff | (value & 0xFFFU);
+		s.heldCtl = ctl; s.heldColor = s.rd(s.access, 0x701CC);
+		s.holding = true;
+		s.polls = 0;
+		publish(30);
+		if (s.poll) scheduleIn(s.poll, 50);
+		return;
+	} else if (!fits(dst, w, h, bytes, tiling)) {
+		clearBlack(dst + static_cast<size_t>(bytes ? bytes : 12288) * (h ? h : 1920));
+		s.log[15] = 1;
+	} else {
+		uint32_t b = bytes;
+		const auto eff = effectiveTiling(dst, bytes * h, tiling, b);
+		if (eff == 7) { clearBlack(dst + static_cast<size_t>(bytes) * h); s.log[15] = 6; }
+		else { render(dst, w, h, bytes, eff); s.log[15] = eff == 0 ? 2 : 3; s.log[21] = eff + 1; }
+	}
+	publish(30);
+	// The driver's write follows; return borrowed entries once its surface is live.
+	if (s.cleanup) {
+		uint64_t deadline = 0;
+		clock_interval_to_deadline(250, kMillisecondScale, &deadline);
+		thread_call_enter_delayed(s.cleanup, deadline);
+	}
+}
+}
+
+#endif /* kern_bootseamless_hpp */
+
+// -wex-bootfade: the firmware boots at full backlight; the driver later jumps to the saved level
+// in one write. At boot only, turn that first jump into a ~0.8 s fade. Any other duty write by the
+// driver during the fade cancels it and goes through unchanged.
+namespace XeBootFade {
+static int flag = -1;
+static bool done;
+static volatile bool fading;
+static void *access;
+static XeBootSeamless::Read rd;
+static XeBootSeamless::Write wr;
+static uint32_t from, to, step, expect;
+static thread_call_t call;
+static void tick(thread_call_param_t, thread_call_param_t) {
+	if (!fading) return;
+	step++;
+	expect = static_cast<uint32_t>(from + (static_cast<int64_t>(to) - from) * step / 16);
+	wr(access, 0xC8258, expect);
+	if (step >= 16) { fading = false; return; }
+	uint64_t deadline = 0; clock_interval_to_deadline(50, kMillisecondScale, &deadline); thread_call_enter_delayed(call, deadline);
+}
+// Returns true when the write should go through unchanged.
+static bool write(void *acc, uint32_t &value, void *observedAccess, mach_vm_address_t readFn, mach_vm_address_t writeFn) {
+	if (fading) { if (value != expect) fading = false; return true; }
+	if (flag < 0) flag = checkKernelArgument("-wex-bootfade") ? 1 : 0;
+	if (flag != 1 || done || !acc || acc != observedAccess || !readFn || !writeFn) return true;
+	uint64_t up = 0, ns = 0; clock_get_uptime(&up); absolutetime_to_nanoseconds(up, &ns);
+	if (ns > 60000000000ULL) { done = true; return true; }
+	access = acc; rd = reinterpret_cast<XeBootSeamless::Read>(readFn); wr = reinterpret_cast<XeBootSeamless::Write>(writeFn);
+	const auto cur = rd(acc, 0xC8258);
+	done = true;
+	if (cur == value) return true;
+	if (!call) call = thread_call_allocate(tick, nullptr);
+	if (!call) return true;
+	from = cur; to = value; step = 0; expect = cur; fading = true;
+	value = cur; // keep the current level now; the thread call walks to the target
+	uint64_t log[4] {ns, from, to, 0};
+	IORegistryEntry::getRegistryRoot()->setProperty("WhateverXeBootFade", log, sizeof(log));
+	uint64_t deadline = 0; clock_interval_to_deadline(50, kMillisecondScale, &deadline); thread_call_enter_delayed(call, deadline);
+	return true;
+}
+}
+
+// -wex-bootquiet: keep the firmware backlight level and keep the cursor plane off during boot;
+// shortly after the desktop appears, show the cursor and fade to the requested backlight level.
+namespace XeBootQuiet {
+static int flag = -1;
+static bool started, ended;
+static volatile bool active, fading;
+static void *access;
+static XeBootSeamless::Read rd;
+static XeBootSeamless::Write wr;
+static uint32_t keepDuty, wantDuty, curCtl, curBase, from, step, expect;
+static bool haveDuty, haveCur;
+static thread_call_t timer, fadeCall;
+static uint64_t log[8];
+static void publish() { IORegistryEntry::getRegistryRoot()->setProperty("WhateverXeBootQuiet", log, sizeof(log)); }
+static void after(thread_call_t c, uint32_t ms) { uint64_t d = 0; clock_interval_to_deadline(ms, kMillisecondScale, &d); thread_call_enter_delayed(c, d); }
+static void fadeTick(thread_call_param_t, thread_call_param_t) {
+	if (!fading) return;
+	step++;
+	expect = static_cast<uint32_t>(from + (static_cast<int64_t>(wantDuty) - from) * step / 30);
+	wr(access, 0xC8258, expect);
+	if (step >= 30) { fading = false; return; }
+	after(fadeCall, 50);
+}
+static void end() {
+	active = false; ended = true;
+	log[4] = XeBootSeamless::nowNs();
+	if (haveCur) { wr(access, 0x70080, curCtl); wr(access, 0x70084, curBase); }
+	if (haveDuty && wantDuty != keepDuty && fadeCall) { from = keepDuty; step = 0; expect = keepDuty; fading = true; after(fadeCall, 50); }
+	publish();
+}
+static void timerTick(thread_call_param_t, thread_call_param_t) {
+	if (!active) return;
+	const auto now = XeBootSeamless::nowNs(), rel = XeBootSeamless::s.releaseNs;
+	const bool seamless = XeBootSeamless::s.flag == 1 && XeBootSeamless::s.done;
+	if (now > 60000000000ULL || (rel && now > rel + 14000000000ULL) || (!seamless && now > 38000000000ULL) ||
+		(seamless && !rel && !XeBootSeamless::s.holding && now > 45000000000ULL)) { end(); return; }
+	after(timer, 250);
+}
+// Called for backlight duty and cursor writes before they are forwarded.
+static void write(void *acc, unsigned long reg, uint32_t &value, void *observedAccess, mach_vm_address_t readFn, mach_vm_address_t writeFn) {
+	if (fading && reg == 0xC8258) { if (value != expect) fading = false; return; }
+	if (ended) return;
+	if (!started) {
+		if (flag < 0) flag = checkKernelArgument("-wex-bootquiet") ? 1 : 0;
+		if (flag != 1 || !acc || acc != observedAccess || !readFn || !writeFn) return;
+		if (XeBootSeamless::nowNs() > 40000000000ULL) { ended = true; return; }
+		access = acc; rd = reinterpret_cast<XeBootSeamless::Read>(readFn); wr = reinterpret_cast<XeBootSeamless::Write>(writeFn);
+		timer = thread_call_allocate(timerTick, nullptr); fadeCall = thread_call_allocate(fadeTick, nullptr);
+		if (!timer) { ended = true; return; }
+		keepDuty = rd(acc, 0xC8258);
+		started = true; active = true;
+		log[0] = XeBootSeamless::nowNs(); log[1] = keepDuty;
+		after(timer, 250);
+	}
+	if (!active || acc != access) return;
+	if (reg == 0xC8258) { wantDuty = value; haveDuty = true; value = keepDuty; log[2] = wantDuty; }
+	else if (reg == 0x70080) { curCtl = value; haveCur = true; value = 0; log[3] = curCtl; }
+	else if (reg == 0x70084) { curBase = value; }
+	publish();
+}
+}
diff --git a/WhateverXe/kern_gpustat.hpp b/WhateverXe/kern_gpustat.hpp
new file mode 100644
index 0000000..393d255
--- /dev/null
+++ b/WhateverXe/kern_gpustat.hpp
@@ -0,0 +1,137 @@
+//
+//  kern_gpustat.hpp
+//  WhateverXe
+//
+//  Tiger Lake accelerator "Device Utilization %" (registered only with -wex-gpustat).
+//
+//  On this configuration IGAccelStatistics::writePerformanceStats(OSDictionary *, bool) is only
+//  ever called with its "live" argument false and the telemetry busy accumulators stay at zero, so
+//  the published utilization is always 0. The driver does compute each context's run time when a
+//  context-status event is processed (IGHwCsStatsTracker::updateWithContextUtilizationData stores it
+//  in nanoseconds at tracker+0x658[engine]). This module sums those run times per engine and, after
+//  the original statistics writer returns, replaces the utilization keys in the dictionary with
+//  busy time / wall time since the previous call. Driver state is never modified.
+//  Diagnostics: registry-root property "WhateverXeGpuStat".
+//
+
+#ifndef kern_gpustat_hpp
+#define kern_gpustat_hpp
+
+#include <Headers/kern_api.hpp>
+#include <IOKit/IORegistryEntry.h>
+#include <kern/clock.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+
+namespace XeGpuStat {
+static constexpr size_t Engines = 6;
+static bool requested, routedWrite, routedTrack;
+static uint32_t writeCalls, trackCalls, trackSkipped;
+static uint64_t busyNs[Engines];            // summed context run time per engine
+static uint64_t lastBusyNs[Engines], lastWallNs;
+using Write = void (*)(void *, OSDictionary *, bool);
+using Track = void (*)(void *, void *);
+static Write orgWrite;
+static Track orgTrack;
+
+template <typename T> static inline T rd(const void *base, size_t off) {
+	T v; memcpy(&v, static_cast<const uint8_t *>(base) + off, sizeof(v)); return v;
+}
+static inline uint64_t nowNs() {
+	uint64_t t = 0, ns = 0; clock_get_uptime(&t); absolutetime_to_nanoseconds(t, &ns); return ns;
+}
+static inline void put(OSDictionary *dict, const char *key, uint32_t value) {
+	if (auto n = OSNumber::withNumber(static_cast<unsigned long long>(value), 32)) { dict->setObject(key, n); n->release(); }
+}
+
+// Runs where the driver processes context-status events; keep it to two loads and an atomic add.
+static void wrapTrack(void *tracker, void *context) {
+	orgTrack(tracker, context);
+	__atomic_add_fetch(&trackCalls, 1, __ATOMIC_RELAXED);
+	if (!tracker || !context) return;
+	const auto engine = rd<uint8_t>(context, 0x78);          // same index the original uses
+	if (engine >= Engines) { __atomic_add_fetch(&trackSkipped, 1, __ATOMIC_RELAXED); return; }
+	const auto runNs = rd<uint64_t>(tracker, 0x658 + engine * 8);
+	// A single context cannot have run longer than a few seconds between two status events.
+	if (runNs > 10000000000ULL) { __atomic_add_fetch(&trackSkipped, 1, __ATOMIC_RELAXED); return; }
+	__atomic_add_fetch(&busyNs[engine], runNs, __ATOMIC_RELAXED);
+}
+
+static void wrapWrite(void *self, OSDictionary *dict, bool live) {
+	orgWrite(self, dict, live);
+	const auto n = __atomic_add_fetch(&writeCalls, 1, __ATOMIC_RELAXED);
+	const auto wall = nowNs();
+	uint64_t busy[Engines], pct[Engines] {}, top = 0;
+	for (size_t i = 0; i < Engines; i++) busy[i] = __atomic_load_n(&busyNs[i], __ATOMIC_RELAXED);
+	const auto span = lastWallNs && wall > lastWallNs ? wall - lastWallNs : 0;
+	// The family calls this every 0.25-2 s; ignore a first call and implausible gaps.
+	const bool valid = span >= 50000000ULL && span <= 10000000000ULL;
+	if (valid) for (size_t i = 0; i < Engines; i++) {
+		const auto delta = busy[i] - lastBusyNs[i];
+		pct[i] = delta * 100 / span;
+		if (pct[i] > 100) pct[i] = 100;
+		if (pct[i] > top) top = pct[i];
+	}
+	for (size_t i = 0; i < Engines; i++) lastBusyNs[i] = busy[i];
+	lastWallNs = wall;
+	// Only take over when the driver itself reported nothing and we have seen run times.
+	if (dict && valid && routedTrack && __atomic_load_n(&trackCalls, __ATOMIC_RELAXED)) {
+		char key[32];
+		for (size_t i = 0; i < Engines; i++) {
+			snprintf(key, sizeof(key), "Device Unit %d Utilization %%", static_cast<int>(i));
+			put(dict, key, static_cast<uint32_t>(pct[i]));
+		}
+		put(dict, "Device Utilization %", static_cast<uint32_t>(top));
+		put(dict, "Device Utilization % at cur p-state", static_cast<uint32_t>(top));
+	}
+	uint64_t rec[24] {};
+	rec[0] = 0x47535432; // 'GST2'
+	rec[1] = n; rec[2] = live; rec[3] = __atomic_load_n(&trackCalls, __ATOMIC_RELAXED);
+	rec[4] = __atomic_load_n(&trackSkipped, __ATOMIC_RELAXED); rec[5] = span; rec[6] = valid; rec[7] = top;
+	for (size_t i = 0; i < Engines; i++) { rec[8 + i] = busy[i]; rec[14 + i] = pct[i]; }
+	if (auto data = OSData::withBytes(rec, sizeof(rec))) {
+		IORegistryEntry::getRegistryRoot()->setProperty("WhateverXeGpuStat", data);
+		data->release();
+	}
+}
+
+static inline void init() {
+	requested = checkKernelArgument("-wex-gpustat");
+}
+
+static inline bool matches(mach_vm_address_t fn, mach_vm_address_t address, size_t size, const uint8_t *prefix, size_t length) {
+	return fn && fn >= address && fn - address < size && size - (fn - address) >= length &&
+		!memcmp(reinterpret_cast<const void *>(fn), prefix, length);
+}
+
+// Called for every kext WhateverXe is notified about; only the image that exports both symbols,
+// with the exact prologues of the 16.0.0 driver this was read from, is routed.
+static inline void processKext(KernelPatcher &patcher, size_t index, mach_vm_address_t address, size_t size) {
+	if (!requested || routedWrite) return;
+	static const char *writeSymbol = "__ZN17IGAccelStatistics21writePerformanceStatsEP12OSDictionaryb";
+	static const char *trackSymbol = "__ZN18IGHwCsStatsTracker32updateWithContextUtilizationDataEP17IGHardwareContext";
+	const auto write = patcher.solveSymbol<mach_vm_address_t>(index, writeSymbol, address, size);
+	patcher.clearError();
+	if (!write) return;
+	const auto track = patcher.solveSymbol<mach_vm_address_t>(index, trackSymbol, address, size);
+	patcher.clearError();
+	static const uint8_t writePrefix[] {0x55,0x48,0x89,0xe5,0x41,0x57,0x41,0x56,0x41,0x55,0x41,0x54,0x53,0x48,0x83,0xec,0x58,0x41,0x89,0xd7};
+	static const uint8_t trackPrefix[] {0x55,0x48,0x89,0xe5,0x41,0x57,0x41,0x56,0x41,0x55,0x41,0x54,0x53,0x48,0x83,0xec,0x58,0x48,0x89,0xf3,0x49,0x89,0xfd};
+	if (!matches(write, address, size, writePrefix, sizeof(writePrefix)) ||
+		!matches(track, address, size, trackPrefix, sizeof(trackPrefix))) {
+		IORegistryEntry::getRegistryRoot()->setProperty("WhateverXeGpuStatReady", false);
+		return;
+	}
+	KernelPatcher::RouteRequest trackRoute(trackSymbol, wrapTrack, orgTrack);
+	routedTrack = patcher.routeMultiple(index, &trackRoute, 1, address, size);
+	patcher.clearError();
+	KernelPatcher::RouteRequest writeRoute(writeSymbol, wrapWrite, orgWrite);
+	routedWrite = patcher.routeMultiple(index, &writeRoute, 1, address, size);
+	patcher.clearError();
+	IORegistryEntry::getRegistryRoot()->setProperty("WhateverXeGpuStatReady", routedWrite);
+	IORegistryEntry::getRegistryRoot()->setProperty("WhateverXeGpuStatTrack", routedTrack);
+}
+}
+
+#endif /* kern_gpustat_hpp */
