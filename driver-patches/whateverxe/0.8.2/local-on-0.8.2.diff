+SYSCTL_INT(_debug, OID_AUTO, wexctia, CTLFLAG_RW | CTLFLAG_LOCKED, &wexCtia, 0, "keep ALC257 headset coefficients 0x45/0x1B");
+static int wexCoefNib(uint16_t verb) {
+	if (verb <= 0xF) return verb;
+	if ((verb & 0xFF) == 0 && (verb >> 8) <= 0xD) return verb >> 8;
+	return -1;
+}
+static void wexCtiaSchedule() {
+	if (!wexCtia || !wexCtiaCall) return;
+	uint64_t deadline = 0; clock_interval_to_deadline(300, kMillisecondScale, &deadline);
+	thread_call_enter_delayed(wexCtiaCall, deadline);
+}
+static void wexCtiaCheck(thread_call_param_t, thread_call_param_t) {
+	auto that = wexCtiaThat;
+	if (!wexCtia || !that || !wexHdaOrgVerb || !wexHdaLock) return;
+	using Verb = uint32_t (*)(void *, uint16_t, uint16_t, uint16_t, uint32_t *, bool);
+	auto org = reinterpret_cast<Verb>(wexHdaOrgVerb);
+	__atomic_fetch_add(&wexCtiaChecks, 1, __ATOMIC_RELAXED);
+	IOLockLock(wexHdaLock);
+	uint32_t sense = 0, junk = 0;
+	org(that, 0x21, 0xF09, 0, &sense, true);
+	const bool present = (sense & 0x80000000U) != 0;
+	wexHpPresent = present;
+	if (present) {
+		static const uint16_t idx[2] {0x45, 0x1B}, val[2] {0xD489, 0x0C2B};
+		for (int i = 0; i < 2; i++) {
+			uint32_t cur = 0xFFFFFFFF;
+			org(that, 0x20, 0x5, idx[i], &junk, true);
+			org(that, 0x20, 0xC, 0, &cur, true);
+			if ((cur & 0xFFFF) != val[i] && cur != 0xFFFFFFFF) {
+				org(that, 0x20, 0x5, idx[i], &junk, true);
+				org(that, 0x20, 0x4, val[i], &junk, true);
+				__atomic_fetch_add(&wexCtiaFixed, 1, __ATOMIC_RELAXED);
+			}
+		}
+	}
+	wexCoefIdx = 0xFFFF;
+	IOLockUnlock(wexHdaLock);
+}
+static uint32_t wexHdaFuncVerb(void *that, uint16_t nid, uint16_t verb, uint16_t param, uint32_t *output, bool waitForSuccess) {
+	__atomic_fetch_add(&wexDepopSeen, 1, __ATOMIC_RELAXED);
+	if (nid == 0x19 || nid == 0x20 || nid == 0x21) wexCtiaThat = that;   // the ALC257 function, not the display-audio codec
+	const bool pin = wexDepop && nid == 0x21 && verb == 0x707;
+	if (wexMicIn && nid == 0x19 && verb == 0x707 && !(param & 0x20)) { param |= 0x20; __atomic_fetch_add(&wexMicInFixed, 1, __ATOMIC_RELAXED); }
