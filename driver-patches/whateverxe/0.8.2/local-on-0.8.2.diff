+	IOSimpleLockUnlockEnableInterrupt(wexPsr1Lock, st);
+	if (was) if (auto s = wexPsr1Reg(0x60840)) for (int i = 0; i < 200 && (*s >> 29) != 0; i++) IODelay(500);   // up to 100 ms for IDLE
+}
+static bool wexPsr1PipeOK() {
+	auto pipe = wexPsr1Reg(0x70008), ddi = wexPsr1Reg(0x60400);
+	if (!pipe || !ddi) return false;
+	const uint32_t p = *pipe, d = *ddi; wexPsr1Ddi = d;
+	return (p & 0xC0000000U) == 0xC0000000U && (d & 0x80000000U) && ((d >> 27) & 0xF) == 1 && ((d >> 24) & 7) == 2;
+}
+static void wexPsr1Event(uint32_t reason) {
+	wexDcOffHook(reason);
+	// display path activity: stop now and require a new quiet period; disableDisplay also invalidates the sink enable
+	__atomic_store_n(&wexPsr1EventNs, wexPsr1Now(), __ATOMIC_RELEASE);
+	if (reason == 8) __atomic_store_n(&wexPsr1SinkOK, 0, __ATOMIC_RELEASE);
