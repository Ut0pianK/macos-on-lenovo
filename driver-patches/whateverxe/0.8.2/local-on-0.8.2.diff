+	auto add = [&](const char *who, IORegistryEntry *e, const char *const *paths, size_t count) {
+		auto d = e ? static_cast<IOACPIPlatformDevice *>(e->metaCast("IOACPIPlatformDevice")) : nullptr;
+		if (!d) { n += (size_t)snprintf(buf + n, sizeof(buf) - n, "%s:none ", who); return; }
