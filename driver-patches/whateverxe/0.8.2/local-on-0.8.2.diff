+static thread_call_t wexL1ssCall;
+static IOPCIDevice *wexL1ssFind(uint8_t bus, uint8_t dev, uint8_t fn) {
+	IOPCIDevice *found = nullptr;
+	if (auto it = IORegistryIterator::iterateOver(gIOServicePlane, kIORegistryIterateRecursively)) {
+		while (auto e = it->getNextObject()) {
+			auto d = OSDynamicCast(IOPCIDevice, e);
+			if (d && d->getBusNumber() == bus && d->getDeviceNumber() == dev && d->getFunctionNumber() == fn) { d->retain(); found = d; break; }
+		}
+		it->release();
+	}
+	return found;
+}
+static void wexL1ssPair(int idx, uint8_t pdev, bool enable) {
+	auto st = wexL1ssStat[idx]; st[7] = 1;
+	auto port = wexL1ssFind(0, pdev, 0);
+	if (!port) { st[7] = 0x10; return; }
+	IOPCIDevice *ep = nullptr;
+	const uint8_t sec = port->configRead8(0x19);                              // secondary bus
+	if (sec) ep = wexL1ssFind(sec, 0, 0);
+	if (!ep) { st[7] = 0x11; port->release(); return; }
+	const uint32_t pl = wexPmcExt(port, 0x1E), el = wexPmcExt(ep, 0x1E);
+	uint8_t pe = 0, ee = 0;
+	if (!pl || !el || !port->findPCICapability(0x10, &pe) || !ep->findPCICapability(0x10, &ee) || !pe || !ee ||
+		(ep->configRead16(0) == 0xFFFF)) { st[7] = 0x12; port->release(); ep->release(); return; }
+	const uint32_t pcap = port->extendedConfigRead32(pl + 4), ecap = ep->extendedConfigRead32(el + 4);
+	st[0] = (uint64_t)pcap << 32 | ecap;
+	st[1] = (uint64_t)port->extendedConfigRead32(pl + 8) << 32 | ep->extendedConfigRead32(el + 8);
+	st[2] = (uint64_t)port->extendedConfigRead32(pl + 0xC) << 32 | ep->extendedConfigRead32(el + 0xC);
+	uint32_t common = pcap & ecap & 0xF;                                       // PCI-PM L1.2, L1.1, ASPM L1.2, L1.1
+	// ASPM L1.2 needs LTR enabled on the endpoint; without it keep only the L1.1 states
+	if (!(ep->configRead16(ee + 0x28) & 0x400)) common &= ~0x4U;
+	const uint16_t plc = port->configRead16(pe + 0x10), elc = ep->configRead16(ee + 0x10);
+	// 1. ASPM L1 off: endpoint first, then the port
+	ep->configWrite16(ee + 0x10, elc & ~0x2); port->configWrite16(pe + 0x10, plc & ~0x2);
+	// 2. all substates off: endpoint first
+	ep->extendedConfigWrite32(el + 8, ep->extendedConfigRead32(el + 8) & ~0xFU);
+	port->extendedConfigWrite32(pl + 8, port->extendedConfigRead32(pl + 8) & ~0xFU);
+	if (enable && common) {
+		static const uint32_t tscale[] {2, 10, 100, 0};
+		const uint32_t pv = (pcap >> 19) & 0x1F, ps = (pcap >> 16) & 3, ev = (ecap >> 19) & 0x1F, es = (ecap >> 16) & 3;
+		const uint32_t pt = pv * tscale[ps], et = ev * tscale[es];
+		const uint32_t tv = pt >= et ? pv : ev, ts = pt >= et ? ps : es, tpo = pt >= et ? pt : et;
+		const uint32_t cm = ((pcap >> 8) & 0xFF) > ((ecap >> 8) & 0xFF) ? (pcap >> 8) & 0xFF : (ecap >> 8) & 0xFF;
+		const uint32_t ctl2 = ts | tv << 3;
+		// LTR_L1.2_THRESHOLD = 2 + 4 + common mode + T_POWER_ON (us), encoded value(10 bits) x 1024 ns or x 32768 ns
+		const uint64_t ns = (uint64_t)(2 + 4 + cm + tpo) * 1000;
+		uint32_t thv, ths;
+		if (ns <= 1023ULL * 1024) { ths = 2; thv = (uint32_t)((ns + 1023) / 1024); } else { ths = 3; thv = (uint32_t)((ns + 32767) / 32768); }
+		port->extendedConfigWrite32(pl + 0xC, ctl2); ep->extendedConfigWrite32(el + 0xC, ctl2);
+		uint32_t pc = port->extendedConfigRead32(pl + 8) & ~(0xFF00U | 0x03FF0000U | 0xE0000000U | 0xFU);
+		uint32_t ec = ep->extendedConfigRead32(el + 8) & ~(0x03FF0000U | 0xE0000000U | 0xFU);
+		pc |= cm << 8 | thv << 16 | ths << 29; ec |= thv << 16 | ths << 29;
+		port->extendedConfigWrite32(pl + 8, pc); ep->extendedConfigWrite32(el + 8, ec);
+		// 3. enables: port first, then the endpoint
+		port->extendedConfigWrite32(pl + 8, pc | common); ep->extendedConfigWrite32(el + 8, ec | common);
+		st[7] = 2;
+	} else st[7] = enable ? 0x13 : 3;
+	// 4. ASPM L1 back as it was: port first, then the endpoint
+	port->configWrite16(pe + 0x10, plc); ep->configWrite16(ee + 0x10, elc);
+	st[3] = (uint64_t)port->extendedConfigRead32(pl + 8) << 32 | ep->extendedConfigRead32(el + 8);
+	st[4] = (uint64_t)port->extendedConfigRead32(pl + 0xC) << 32 | ep->extendedConfigRead32(el + 0xC);
+	st[5] = (uint64_t)port->configRead32(pe + 0x10) << 32 | ep->configRead32(ee + 0x10);
+	st[6] = common;
+	port->release(); ep->release();
+}
+static void wexL1ssApply(thread_call_param_t, thread_call_param_t) {
+	wexL1ssPair(0, 0x1C, wexL1ss & 1);
+	wexL1ssPair(1, 0x1D, wexL1ss & 2);
+	wexPmcScan(nullptr, nullptr);          // refresh the PCI survey so the registers can be read back from user space
