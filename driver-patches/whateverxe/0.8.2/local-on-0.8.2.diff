+//
+//  kern_userpatch.hpp
+//  WhateverXe
+//
+//  Optional in-memory fixes for the Tiger Lake user-space graphics bundles.
+//  They are registered only with the -wex-userpatch boot argument and need a Lilu
+//  build with the user patcher enabled on macOS 11+ (page patching mode). The files
+//  on disk stay untouched: pages are patched after code signature validation.
+//
+
+#ifndef kern_userpatch_hpp
+#define kern_userpatch_hpp
+
+#include <Headers/kern_api.hpp>
+#include <Headers/kern_user.hpp>
+
+namespace XeUserPatch {
+
+// AppleIntelTGLGraphicsMTLDriver, -[MTLIGAccelCommandBuffer dealloc] (file offset 0x7ed82):
+// always free the per-command-buffer target buffer (jne -> nop nop), fixes the WindowServer leak.
+static const uint8_t mtlLeakFind[] {0x41, 0x80, 0x3c, 0x06, 0x00, 0x75, 0x0d, 0xe8, 0x7a, 0xfa, 0x01, 0x00};
+static const uint8_t mtlLeakRepl[] {0x41, 0x80, 0x3c, 0x06, 0x00, 0x90, 0x90, 0xe8, 0x7a, 0xfa, 0x01, 0x00};
+
+// AppleIntelTGLGraphicsVADriver (file offset 0x1336e1): return error 5 when component 0 is missing.
+static const uint8_t vaPrepFind[] {
+	0x48, 0x81, 0xc2, 0xb0, 0x2c, 0x00, 0x00, 0x48, 0x8b, 0x4d, 0xd8, 0x48, 0x8b, 0xb9, 0x10, 0x09,
+	0x00, 0x00, 0x48, 0x89, 0x57, 0x08, 0x8b, 0x45, 0xe4, 0x48, 0x83, 0xc4, 0x30, 0x5d, 0xc3};
+static const uint8_t vaPrepRepl[] {
+	0x48, 0x8b, 0xba, 0x10, 0x09, 0x00, 0x00, 0x8b, 0x45, 0xe4, 0x48, 0x85, 0xff, 0x74, 0x06, 0x48,
+	0x89, 0x4f, 0x08, 0xeb, 0x05, 0xb8, 0x05, 0x00, 0x00, 0x00, 0xc9, 0xc3, 0x90, 0x90, 0x90};
+
+// AppleIntelTGLGraphicsVADriver (file offset 0x130e80): take the existing error exit when component 0 is missing.
+static const uint8_t vaConvFind[] {
+	0x48, 0x8b, 0x45, 0xa0, 0x8b, 0x88, 0xbc, 0x09, 0x00, 0x00, 0x83, 0xc1, 0x00, 0x89, 0xc9, 0x89,
+	0xca, 0x48, 0x8b, 0xbc, 0xd0, 0x10, 0x09, 0x00, 0x00, 0x48, 0x8b, 0x55, 0xf0, 0x48, 0x89, 0xc6};
+static const uint8_t vaConvRepl[] {
+	0x48, 0x8b, 0x45, 0xa0, 0x8b, 0x88, 0xbc, 0x09, 0x00, 0x00, 0x48, 0x8b, 0xbc, 0xc8, 0x10, 0x09,
+	0x00, 0x00, 0x48, 0x85, 0xff, 0x74, 0xc6, 0x48, 0x8b, 0x55, 0xf0, 0x48, 0x89, 0xc6, 0x90, 0x90};
+
