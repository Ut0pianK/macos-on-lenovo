+	uint32_t before = *en, loops = 0, waited = 0;
+	// the DMC may put the old value back while it is leaving a DC state: rewrite until it sticks (Linux: up to 100 tries)
+	for (; loops < 100; loops++) { *en = before & ~0xBU; if ((*en & 0xB) == 0) { IODelay(10); if ((*en & 0xB) == 0) break; } }
+	// DMC restore: power well 1 state, CDCLK PLL lock, DBUF slice 1 state; up to 100 ms
+	for (; waited < 1000; waited++) { if ((*pw & 1) && (*pll & 0x40000000U) && (*dbuf & 0x40000000U)) break; IODelay(100); }
+	wexDcStat[4] = (uint64_t)why << 32 | before; wexDcStat[5] = (uint64_t)loops << 32 | waited;
+	wexDcStat[6] = (uint64_t)*pw << 32 | *en; wexDcStat[7] = (uint64_t)*pll << 32 | *dbuf; wexDcStat[8]++;
+	__atomic_store_n(&wexDcArmed, 0, __ATOMIC_RELEASE);
+}
+static int wexDmcLoad() {
+	if (wexDmcLoaded == 1) return 0;
+	auto en = wexPsr1Reg(0x45504), pw = wexPsr1Reg(0x45400), prog = wexPsr1Reg(0x80000), dbg = wexPsr1Reg(0x45520);
+	if (!en || !pw || !prog || !dbg) return ENXIO;
+	if ((*en & 0xB) || !(*pw & 1)) return EBUSY;                           // a DC state is enabled, or power well 1 is down
+	wexDcStat[0] = (uint64_t)*prog << 32 | *en;
+	for (uint32_t i = 0; i < arrsize(kWexTglDmcPayload); i++) prog[i] = kWexTglDmcPayload[i];
+	for (uint32_t i = 0; i < arrsize(kWexTglDmcMmio); i++) if (auto r = wexPsr1Reg(kWexTglDmcMmio[i][0])) *r = kWexTglDmcMmio[i][1];
+	*dbg = *dbg | 2;                                                       // DC_STATE_DEBUG_MASK_MEMORY_UP
+	uint32_t bad = 0;
+	for (uint32_t i = 0; i < arrsize(kWexTglDmcPayload); i++) if (prog[i] != kWexTglDmcPayload[i]) bad++;
+	for (uint32_t i = 0; i < arrsize(kWexTglDmcMmio); i++) if (auto r = wexPsr1Reg(kWexTglDmcMmio[i][0])) if (*r != kWexTglDmcMmio[i][1]) bad += 0x10000;
+	wexDcStat[1] = (uint64_t)prog[0] << 32 | bad; wexDcStat[2] = *dbg;
+	__atomic_store_n(&wexDmcLoaded, bad ? 2 : 1, __ATOMIC_RELEASE);
+	return 0;
+}
+// The DMC program RAM and its handler registers survive a warm reboot. Booting with them still in place makes the
+// audio driver spin (a thread call in AppleHDA at ~70% CPU; seen 2026-11-14 on three warm reboots, never on a cold
+// boot or when the program is loaded after boot). So the program is taken out again before a restart or shutdown:
+// DC states off, the nine handler registers back to 0 (their cold-boot value), the program area zeroed.
+static void wexDmcUnload() {
+	if (!wexDmcLoaded) return;
+	__atomic_store_n(&wexDcArmed, 1, __ATOMIC_RELEASE); wexDcOff(0x400);       // whatever DC_STATE_EN holds, clear and wait
+	for (uint32_t i = 0; i < arrsize(kWexTglDmcMmio); i++) if (auto r = wexPsr1Reg(kWexTglDmcMmio[i][0])) *r = 0;
+	if (auto prog = wexPsr1Reg(0x80000)) for (uint32_t i = 0; i < arrsize(kWexTglDmcPayload); i++) prog[i] = 0;
+	__atomic_store_n(&wexDmcLoaded, 0, __ATOMIC_RELEASE);
+	wexDcStat[1] = (wexDcStat[1] & 0xFFFFFFFFULL) | 0xDEADULL << 48;                // marks "unloaded" in the report
+}
+// Early scrub (2026-11-15): a panic, a hardware reset or any restart that skips the shutdown hook above leaves the program
+// in place. At kernel-patcher time (before AppleHDA and the framebuffer start) the nine handler registers are checked:
+// they read 0 after a cold boot, so any non-zero one means a leftover program. Then DC states are cleared and the
+// registers and the program area are zeroed, as wexDmcUnload does. (The program area itself is not a usable test: after
+// a cold boot it holds random SRAM contents.) Only with -wex-dc6. "WhateverXeDmcScrub" = non-zero registers found.
+static void wexDmcEarlyScrub(IOPCIDevice *pci) {
+	if (!pci || !checkKernelArgument("-wex-dc6") || !(pci->configRead16(4) & 2)) return;
+	auto map = pci->mapDeviceMemoryWithRegister(kIOPCIConfigBaseAddress0, kIOMapInhibitCache);
+	if (!map) return;
+	auto base = reinterpret_cast<volatile uint8_t *>(map->getVirtualAddress());
+	const auto len = map->getLength();
+	auto reg = [&](uint32_t off) -> volatile uint32_t * { return off + 4 <= len ? reinterpret_cast<volatile uint32_t *>(base + off) : nullptr; };
+	uint32_t found = 0;
+	for (uint32_t i = 0; i < arrsize(kWexTglDmcMmio); i++) if (auto r = reg(kWexTglDmcMmio[i][0])) if (*r) found++;
+	if (found) {
+		if (auto en = reg(0x45504)) *en = *en & ~0xBU;
+		for (uint32_t i = 0; i < arrsize(kWexTglDmcMmio); i++) if (auto r = reg(kWexTglDmcMmio[i][0])) *r = 0;
+		for (uint32_t i = 0; i < arrsize(kWexTglDmcPayload); i++) if (auto r = reg(0x80000 + i * 4)) *r = 0;
+	}
+	map->release();
+	IORegistryEntry::getRegistryRoot()->setProperty("WhateverXeDmcScrub", found, 32);
+}
+// 0.8.1+ defers XE::processKernel to the first graphics-stack image, which can be after the audio driver
+// started. Keep the scrub at kernel-patcher time (as in 0.8.0) for the profile that 0.8.0 ran it for:
+// an admitted Tiger Lake XeD display (tglActive). The scrub itself still requires -wex-dc6.
+void wexDmcEarlyScrubAtPatcher(IOPCIDevice *pci, const XELP::Profile &profile) {
+	static bool done;
+	if (done || !pci) return;
+	if (!(profile.admitted() && profile.display == XELP::Display::XeD &&
+		  XELP::displayAdapter(profile.family) == XELP::DisplayAdapter::TGL && !checkKernelArgument("-wex-tgl-off") &&
+		  XELP::kernelOS(version) != XELP::OS::Unknown)) return;
+	done = true;
+	wexDmcEarlyScrub(pci);
+}
+static void wexPolShutdown();
+static IOReturn wexDmcShutdownInterest(void *, void *, UInt32 messageType, IOService *, void *, vm_size_t) {
+	if (messageType == kIOMessageSystemWillRestart || messageType == kIOMessageSystemWillPowerOff) { wexDc6AutoOff(); wexDmcUnload(); wexPolShutdown(); }
+	return kIOReturnSuccess;
+}
+static int wexDmcSysctl SYSCTL_HANDLER_ARGS {
+	int v = (int)wexDmcLoaded;
+	const int err = sysctl_handle_int(oidp, &v, 0, req);
+	if (err || !req->newptr) return err;
+	if (v == 0) { wexDc6AutoOff(); wexDmcUnload(); return 0; }
+	if (v != 1) return EINVAL;
+	return wexDmcLoad();
+}
+// -wex-dc6 / sysctl debug.wexdc6auto (2026-11-14): DC6 while the display is off, with the Tiger Lake DMC loaded here.
+//  The driver's own AppleIntelFramebufferController::setDCState(bool) is the hook: it is called with true after the
+//  display has been disabled for Doze (where Apple's hardware-DC6 mode would arm DC6) and with false as the first step
+//  of waking. With dc6config=0 the original does nothing; the wrapper clears DC_STATE_EN before the original on wake
+//  (waiting for power well 1, CDCLK PLL and DBUF slice 1) and sets "up to DC6" after it on Doze when pipe A is off.
+static int wexDc6Auto = 0;
+static uint64_t wexDc6Arms, wexDc6Refused;
+static void wexDc6Arm() {
+	auto en = wexPsr1Reg(0x45504), pipe = wexPsr1Reg(0x70008);
+	if (!wexDc6Auto || wexDmcLoaded != 1 || !en || !pipe || (*pipe & 0x80000000U) || wexPsr1Phase == 2 || (*en & 0xB)) { wexDc6Refused++; return; }
+	wexDcStat[3] = (uint64_t)2 << 32 | *en;
+	__atomic_store_n(&wexDcArmed, 1, __ATOMIC_RELEASE);
+	*en = (*en & ~0xBU) | 2;
+	wexDc6Arms++;
+}
+static void wexDc6AutoOff() { wexDc6Auto = 0; }
+SYSCTL_INT(_debug, OID_AUTO, wexdc6auto, CTLFLAG_RW | CTLFLAG_LOCKED, &wexDc6Auto, 0, "allow DC6 automatically while the display is off");
+SYSCTL_PROC(_debug, OID_AUTO, wexdmc, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, nullptr, 0, wexDmcSysctl, "I", "load the Tiger Lake DMC 2.12 (write 1); reads 0 none, 1 loaded, 2 read-back mismatch");
+static int wexDcSysctl SYSCTL_HANDLER_ARGS {
+	auto en = wexPsr1Reg(0x45504);
+	int v = en ? (int)(*en & 0xB) : -1;
+	const int err = sysctl_handle_int(oidp, &v, 0, req);
+	if (err || !req->newptr) return err;
+	if (v == 0) { wexDcOff(1); return 0; }
+	if (v != 1 && v != 2) return EINVAL;
+	auto pipe = wexPsr1Reg(0x70008);
+	if (!en || !pipe || wexDmcLoaded != 1) return EBUSY;
+	if (*pipe & 0x80000000U) return EBUSY;                                 // only with the display pipe off
+	if (wexPsr1Phase == 2) return EBUSY;
+	wexDcStat[3] = (uint64_t)v << 32 | *en;
+	__atomic_store_n(&wexDcArmed, 1, __ATOMIC_RELEASE);
+	*en = (*en & ~0xBU) | (uint32_t)v;
+	return 0;
+}
+SYSCTL_PROC(_debug, OID_AUTO, wexdc, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, nullptr, 0, wexDcSysctl, "I", "DC_STATE_EN: 0 off, 1 up to DC5, 2 up to DC6 (display off only)");
+static bool wexDcStatSerialize(void *, void *, OSSerialize *serializer) {
+	uint64_t q[16]; memcpy(q, wexDcStat, sizeof(q));
+	q[9] = (uint64_t)wexDcArmed << 32 | (uint64_t)(wexDc6Auto ? 1 : 0) << 16 | wexDmcLoaded;
+	q[2] = (q[2] & 0xFFFFFFFFULL) | wexDc6Arms << 32;
+	if (auto r = wexPsr1Reg(0x101084)) q[10] = *r;                           // DC5 entry count
+	if (auto r = wexPsr1Reg(0x101088)) q[11] = *r;                           // DC6 entry count
+	if (auto r = wexPsr1Reg(0x45504)) q[12] = *r;
+	if (auto r = wexPsr1Reg(0x45400)) q[13] = *r;
+	if (auto r = wexPsr1Reg(0x46070)) q[14] = *r;
+	if (auto r = wexPsr1Reg(0x45008)) q[15] = *r;
+	auto out = OSData::withBytes(q, sizeof(q)); if (!out) return false;
+	const bool ok = out->serialize(serializer); out->release(); return ok;
+}
+
+// debug.wexpsr1_linkoff: switching the mode stops PSR and forgets the sink setup; PSR comes back in the new mode after the
+// next link training (a display sleep/wake), when the driver thread rewrites DPCD 0x170 with or without MAIN_LINK_ACTIVE.
+static int wexPsr1LinkSysctl SYSCTL_HANDLER_ARGS {
+	int v = wexPsr1LinkOff;
+	const int err = sysctl_handle_int(oidp, &v, 0, req);
+	if (err || !req->newptr) return err;
+	if (v < 0 || v > 1) return EINVAL;
+	__atomic_store_n(&wexPsr1SinkOK, 0, __ATOMIC_RELEASE);
+	wexPsr1Stop(10);
+	wexPsr1LinkOff = v;
+	return 0;
+}
+SYSCTL_PROC(_debug, OID_AUTO, wexpsr1_linkoff, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, nullptr, 0, wexPsr1LinkSysctl, "I", "PSR1 main link off in PSR (takes effect after the next link training)");
+SYSCTL_INT(_debug, OID_AUTO, wexpsr1_loctl, CTLFLAG_RW | CTLFLAG_LOCKED, &wexPsr1LoCtl, 0, "PSR_CTL TP bits used in link-off mode");
+static void wexPsr1Tick(thread_call_param_t, thread_call_param_t) {
+	const auto now = wexPsr1Now();
+	if (wexPsr1Phase == 2) {
+		if (!wexPsr1Enabled) wexPsr1Stop(10);
+		else if (!wexPsr1PipeOK()) { __atomic_store_n(&wexPsr1EventNs, now, __ATOMIC_RELEASE); wexPsr1Stop(4); }
+		else if (wexPsr1Max > 0 && now - wexPsr1OnNs > (uint64_t)wexPsr1Max * 1000000000ULL) { wexPsr1Enabled = 0; wexPsr1Stop(5); }
+		else if (auto st = wexPsr1Reg(0x60840)) { wexPsr1Hist[(*st >> 29) & 7]++; wexPsr1Samples++; }
+	} else if (wexPsr1Enabled && __atomic_load_n(&wexPsr1SinkOK, __ATOMIC_ACQUIRE) &&
+			   now - __atomic_load_n(&wexPsr1EventNs, __ATOMIC_ACQUIRE) > (uint64_t)(wexPsr1Delay < 5 ? 5 : wexPsr1Delay) * 1000000000ULL) {
+		auto ctl = wexPsr1Reg(0x60800), st = wexPsr1Reg(0x60840), dbg = wexPsr1Reg(0x60860);
+		if (!ctl || !st || !dbg || !wexPsr1PipeOK() || (*ctl & 0x80000000U) || (*st >> 29) != 0) {
+			wexPsr1Refused++; __atomic_store_n(&wexPsr1EventNs, now, __ATOMIC_RELEASE);        // try again after another quiet period
+		} else {
+			// link standby: main link stays on (TP times unused). link off: TP1 and TP2 2.5 ms each on exit.
+			const uint32_t v = 0x80000000U | (wexPsr1LinkOff ? ((uint32_t)wexPsr1LoCtl & 0xB30U) : (1U << 27)) | (0x1FU << 20) | (1U << 10) | (uint32_t)(wexPsr1Idle < 1 ? 1 : (wexPsr1Idle > 15 ? 15 : wexPsr1Idle));
+			const auto lock = IOSimpleLockLockDisableInterrupt(wexPsr1Lock);
+			// an event that arrived after the quiet check wins: it has already advanced wexPsr1EventNs
+			if (wexPsr1Phase == 0 && __atomic_load_n(&wexPsr1SinkOK, __ATOMIC_ACQUIRE) &&
+				wexPsr1Now() - __atomic_load_n(&wexPsr1EventNs, __ATOMIC_ACQUIRE) > 5000000000ULL) {
+				*dbg = (*dbg & 0x0000FFFFU) | ((uint32_t)wexPsr1Mask & 0x1E010000U);
+				*ctl = v; wexPsr1Ctl = v; wexPsr1OnNs = wexPsr1Now(); wexPsr1Phase = 2; wexPsr1Ons++;
+			}
+			IOSimpleLockUnlockEnableInterrupt(wexPsr1Lock, lock);
+		}
+	}
+	uint64_t deadline = 0; clock_interval_to_deadline(250, kMillisecondScale, &deadline);
+	thread_call_enter_delayed(wexPsr1Call, deadline);
+}
+static void wexPsr1Start() {
+	// called once from the patcher when -wex-psr1 is present
+	if (wexPsr1Call) return;
+	wexPsr1Lock = IOSimpleLockAlloc();
+	wexPsr1Call = thread_call_allocate(wexPsr1Tick, nullptr);
+	if (!wexPsr1Lock || !wexPsr1Call) { wexPsr1Requested = false; return; }
+	sysctl_register_oid(&sysctl__debug_wexpsr1); sysctl_register_oid(&sysctl__debug_wexpsr1_delay); sysctl_register_oid(&sysctl__debug_wexpsr1_max);
+	sysctl_register_oid(&sysctl__debug_wexpsr1_linkoff); sysctl_register_oid(&sysctl__debug_wexpsr1_loctl);
+	PE_parse_boot_argn("wexpsr1idle", &wexPsr1Idle, sizeof(wexPsr1Idle));
+	sysctl_register_oid(&sysctl__debug_wexpsr1_idle); sysctl_register_oid(&sysctl__debug_wexpsr1_mask);
+	uint64_t deadline = 0; clock_interval_to_deadline(60, kSecondScale, &deadline);
+	thread_call_enter_delayed(wexPsr1Call, deadline);
+}
+static bool wexPsr1StatSerialize(void *, void *, OSSerialize *serializer) {
+	uint64_t q[28] {};
+	q[0] = 0x3154415453525350ULL;             // "PSRSTAT1"
+	q[1] = (uint64_t)wexPsr1Reason << 16 | (uint64_t)wexPsr1Phase << 8 | (wexPsr1SinkOK ? 4 : 0) | (wexPsr1LinkOff ? 2 : 0) | (wexPsr1Enabled ? 1 : 0);
+	q[2] = (uint64_t)wexPsr1SinkResult << 32 | wexPsr1SinkWrites;
+	q[3] = wexPsr1Offs << 32 | (wexPsr1Ons & 0xFFFFFFFFU);
+	q[4] = wexPsr1ActiveNs + (wexPsr1Phase == 2 ? wexPsr1Now() - wexPsr1OnNs : 0);
+	q[5] = wexPsr1Samples;
+	for (int i = 0; i < 8; i++) q[6 + i] = wexPsr1Hist[i];
+	q[14] = (uint64_t)wexPsr1Ctl << 32 | wexPsr1Ddi;
+	q[15] = (uint64_t)wexPsr1Refused << 32 | (wexPsr1Cap & 0xFFFF);
+	for (int i = 0; i < 12; i++) q[16 + i] = wexPsr1Reasons[i];
+	auto out = OSData::withBytes(q, sizeof(q)); if (!out) return false;
+	const bool ok = out->serialize(serializer); out->release(); return ok;
+}
+// -wex-pmcstat (2026-11-14, read-only diagnostics for package C9/C10): "WhateverXePmcStat" publishes
+//  [0] marker, [1] flags, [2..9] MSRs (PKGC3/6/7/8/9/10 IRTL 0x60A-0x60C,0x633-0x635, core C6/C7 residency of this CPU), [11] TSC,
+//  [16..16+N) raw PCH PMC registers PWRM+0x1B00..0x1E2F as u32 pairs (LTR ignore, per-IP LTR, low-power-mode status),
+//  then SLP_S0 debug 0x10B4..0x10BF, PM_CFG 0x1818, SLP_S0 residency 0x193C, and a PCI survey taken by a worker thread
+//  60 s after start (never from the registry serialization path): 8 u64 per device.
+// EPB: sysctl debug.wexepb (0 performance .. 15 power save, -1 = leave) writes IA32_ENERGY_PERF_BIAS on every CPU;
+//  boot-arg wexepb=N applies it 60 s after start. Nothing is written unless one of the two is used.
+extern "C" void mp_rendezvous_no_intrs(void (*action_func)(void *), void *arg);
