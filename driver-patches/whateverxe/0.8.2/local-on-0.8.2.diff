+static IOMemoryMap *wexPmcMap;
+static uint64_t wexPmcPci[32][8]; static uint32_t wexPmcPciCount, wexPmcPciScans;
+static thread_call_t wexPmcCall;
+// sysctl debug.wexirtl (2026-11-15, PC10 investigation): the six package C-state interrupt response time limit MSRs
+// (PKGC3/6/7/8/9/10_IRTL, 0x60A-0x60C, 0x633-0x635) were found all zero (invalid): the BIOS does not program them.
+// 1 writes a typical BIOS set (valid bit + 1024 ns units: 0x884E 0x8876 0x8894 0x88FA 0x894C 0x8BF2 — values as seen
+// in turbostat dumps of other Intel laptops, an assumption), 0 writes zeros back. Writes go through the kernel's
+// _wrmsr_carefully (a refused write returns an error instead of faulting); the MSRs are package scoped, one write.
+// Reading returns the number of MSRs that read back as written by the last write (0..6), or -1 before any write.
+static int (*wexWrmsrCarefully)(uint32_t msr, uint64_t value);   // kernel _wrmsr_carefully(msr, value): edx:eax = value
+static int wexIrtl = -1;
+static int wexIrtlSysctl SYSCTL_HANDLER_ARGS {
+	int v = wexIrtl;
+	const int err = sysctl_handle_int(oidp, &v, 0, req);
+	if (err || !req->newptr) return err;
+	if ((v != 0 && v != 1) || !wexWrmsrCarefully || !wexRdmsrCarefully) return EINVAL;
+	static const uint32_t msrs[6] {0x60A, 0x60B, 0x60C, 0x633, 0x634, 0x635};
+	static const uint32_t vals[6] {0x884E, 0x8876, 0x8894, 0x88FA, 0x894C, 0x8BF2};
+	int ok = 0;
+	for (int i = 0; i < 6; i++) {
+		const uint32_t want = v ? vals[i] : 0;
+		if (wexWrmsrCarefully(msrs[i], (uint64_t)want)) continue;
+		uint32_t lo = 0, hi = 0;
+		if (!wexRdmsrCarefully(msrs[i], &lo, &hi) && lo == want) ok++;
+	}
+	wexIrtl = ok;
+	return 0;
+}
+SYSCTL_PROC(_debug, OID_AUTO, wexirtl, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, nullptr, 0, wexIrtlSysctl, "I", "package C-state IRTL MSRs: 1 typical values, 0 zero");
+// sysctl debug.wexltrign (2026-11-15, PC10 investigation): PCH PMC "LTR ignore" register (PWRM 0xFE000000 + 0x1B0C, as
+// Linux pmc_core ltr_ignore on Cannon Lake .. Tiger Lake PCH). Bit n = the IP whose LTR register is 0x1B60 + 4n
+// (bit 4 = XHCI, 9 = HD audio, 10 = CNVi, 17 = ISH). Writing a mask (bits 0..21) stores it in the register, so 0 returns
+// to the firmware state (read 0x0 at boot); reading returns the register. Nothing is written until the sysctl is written.
