+// -wex-cpustat (2026-11-14, read-only diagnostics): live package C-state residency, power-management configuration
+// and RAPL energy counters, read on every registry serialization ("WhateverXeCpuStat", u64 array). Only MSRs that every
+// Tiger Lake-U client part implements are read; the HWP registers only when CPUID.06H:EAX[7] says HWP exists.
+static int (*wexRdmsrCarefully)(uint32_t msr, uint32_t *lo, uint32_t *hi);   // kernel _rdmsr_carefully, solved by name
+static inline uint64_t wexRdmsr(uint32_t msr) { uint32_t lo, hi; asm volatile("rdmsr" : "=a"(lo), "=d"(hi) : "c"(msr)); return ((uint64_t)hi << 32) | lo; }
+static bool wexCpuStatSerialize(void *, void *, OSSerialize *serializer) {
+	uint32_t a, b, c, d;
+	asm volatile("cpuid" : "=a"(a), "=b"(b), "=c"(c), "=d"(d) : "a"(6), "c"(0));
+	const bool hwp = (a >> 7) & 1;
+	uint32_t lo, hi; asm volatile("rdtsc" : "=a"(lo), "=d"(hi));
+	uint64_t q[28] {};
+	q[0] = 0x5453504350ULL;                // "PCPST" marker
+	q[1] = ((uint64_t)hi << 32) | lo;      // TSC
+	q[2] = wexRdmsr(0x60D);                // PC2 residency
+	q[3] = wexRdmsr(0x3F8);                // PC3
+	q[4] = wexRdmsr(0x3F9);                // PC6
+	q[5] = wexRdmsr(0x3FA);                // PC7
+	q[6] = wexRdmsr(0x630);                // PC8
+	q[7] = wexRdmsr(0x631);                // PC9
+	q[8] = wexRdmsr(0x632);                // PC10
+	q[9] = wexRdmsr(0xE2);                 // PKG_CST_CONFIG_CONTROL (package C-state limit, lock)
+	q[10] = wexRdmsr(0x1B0);               // ENERGY_PERF_BIAS (this CPU)
+	q[11] = hwp ? wexRdmsr(0x770) : ~0ULL; // IA32_PM_ENABLE
+	q[12] = hwp ? wexRdmsr(0x771) : ~0ULL; // IA32_HWP_CAPABILITIES
+	q[13] = hwp ? wexRdmsr(0x774) : ~0ULL; // IA32_HWP_REQUEST (this CPU: min, max, desired, EPP)
+	q[14] = wexRdmsr(0x606);               // RAPL_POWER_UNIT
+	q[15] = wexRdmsr(0x611);               // PKG_ENERGY_STATUS
+	q[16] = wexRdmsr(0x639);               // PP0 (cores) energy
+	q[17] = wexRdmsr(0x641);               // PP1 (graphics) energy
+	q[18] = wexRdmsr(0x3FD);               // core C6 (this core)
+	q[19] = wexRdmsr(0x3FE);               // core C7 (this core)
+	q[20] = wexRdmsr(0x198);               // PERF_STATUS (current ratio)
+	q[21] = wexRdmsr(0x199);               // PERF_CTL
+	q[22] = wexRdmsr(0x1A0);               // MISC_ENABLE
+	q[23] = hwp ? 1 : 0;
+	// Platform (PSYS) energy, MSR 0x64D: whole-system energy when the board wires the PSYS input (0 otherwise).
+	// Read through the kernel's fault-tolerant rdmsr so a part without the MSR cannot fault. q[24] energy, q[25] status
+	// (0 ok, 1 no safe reader, 2 the read faulted), q[26] PP0/PKG power limit info is not used.
+	if (wexRdmsrCarefully) {
+		uint32_t lo = 0, hi = 0;
+		if (wexRdmsrCarefully(0x64D, &lo, &hi) == 0) { q[24] = ((uint64_t)hi << 32) | lo; q[25] = 0; } else q[25] = 2;
+	} else q[25] = 1;
+	auto out = OSData::withBytes(q, sizeof(q)); if (!out) return false;
+	const bool ok = out->serialize(serializer); out->release(); return ok;
+}
