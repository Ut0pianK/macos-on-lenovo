+// -wex-psr1 (2026-11-14, stage 2: persistent eDP PSR1, Linux i915 sequence for display ver 12, transcoder A):
+//  sink : on each successful 16-byte read of DPCD 0x060 on the internal port (same thread as the driver), if DPCD 0x070
+//         reports PSR, write 0x170 = CRC [| MAIN_LINK_ACTIVE] then | ENABLE. -wex-psr1-linkoff drops MAIN_LINK_ACTIVE
+//         (the source then turns the main link off in PSR and sends TP1/TP2 for 2.5 ms each on exit).
+//  source: once the display path has been quiet for debug.wexpsr1_delay seconds (default 30) after a sink enable, and
+//         pipe A + TRANS_DDI_FUNC_CTL_A (DDI A, DP SST) are active, write PSR_DEBUG (only HPD masked) and PSR_CTL.
+//  stop : disableDisplay (also forgets the sink enable: the panel may lose power), enablePipe, link training, a
+//         pipe/DDI guard failure, debug.wexpsr1=0, or debug.wexpsr1_max seconds of activity (0 = no limit). After a
+//         stop it re-enables by the same rule; debug.wexpsr1 is the live on/off switch.
+//  "WhateverXePsr1Stat": u64[28] marker, flags, sink writes, on/off counts, active ns, samples, state histogram, reasons.
+#include <sys/sysctl.h>
+static bool wexPsr1Requested;
+static int wexPsr1LinkOff = 0, wexPsr1LoCtl = (2 << 8) | (2 << 4);   // link-off PSR_CTL bits: TP2/TP3 time 9:8, TP1 time 5:4, TP3 select bit 11
+static int wexPsr1Enabled = 1, wexPsr1Delay = 30, wexPsr1Max = 0;
+// tuning (debug.wexpsr1_idle, debug.wexpsr1_mask): idle frames before entry (1..15) and the PSR_DEBUG mask bits written when
+// PSR is enabled. Mask bits: 25 HPD, 26 memory-up (frontbuffer writes do not force an exit; flips and register writes
+// still do), 27 LPSP, 28 max-sleep, 16 display register writes. A change takes effect the next time PSR is enabled.
+// Default idle frames 2 since 2026-11-14 (measured PSR residency on an idle desktop: 6 frames 25-34 %, 3 frames 60 %,
+// 2 frames 67 %, 1 frame 74 %; 2 frames showed no visible stutter). Boot argument wexpsr1idle=N (1..15) overrides it.
+static int wexPsr1Idle = 2, wexPsr1Mask = 1 << 25;
+static volatile uint32_t wexPsr1Phase;          // 0 idle, 2 active
+static volatile uint32_t wexPsr1Reason, wexPsr1SinkOK;
+static volatile uint32_t wexPsr1SinkWrites, wexPsr1SinkResult = 0xFFFFFFFF, wexPsr1Cap = 0xFFFFFFFF;
+static volatile uint64_t wexPsr1EventNs;
+static uint64_t wexPsr1OnNs, wexPsr1ActiveNs, wexPsr1Samples, wexPsr1Hist[8], wexPsr1Reasons[12], wexPsr1Ons, wexPsr1Offs, wexPsr1Refused;
+static uint32_t wexPsr1Ctl, wexPsr1Ddi;
+static thread_call_t wexPsr1Call;
+static IOMemoryMap *wexPsr1Bar;
+static IOSimpleLock *wexPsr1Lock;
+extern IOPCIDevice *wexPsrGPU();
+SYSCTL_INT(_debug, OID_AUTO, wexpsr1, CTLFLAG_RW | CTLFLAG_LOCKED, &wexPsr1Enabled, 0, "WhateverXe eDP PSR1 on/off");
+SYSCTL_INT(_debug, OID_AUTO, wexpsr1_delay, CTLFLAG_RW | CTLFLAG_LOCKED, &wexPsr1Delay, 0, "quiet seconds before PSR1 is enabled");
+SYSCTL_INT(_debug, OID_AUTO, wexpsr1_idle, CTLFLAG_RW | CTLFLAG_LOCKED, &wexPsr1Idle, 0, "PSR1 idle frames before entry (1..15)");
+SYSCTL_INT(_debug, OID_AUTO, wexpsr1_mask, CTLFLAG_RW | CTLFLAG_LOCKED, &wexPsr1Mask, 0, "PSR_DEBUG mask bits used when PSR1 is enabled");
