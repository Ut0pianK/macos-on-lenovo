+	auto reg = wexLtrIgnMap ? reinterpret_cast<volatile uint32_t *>(wexLtrIgnMap->getVirtualAddress() + 0x1B0C) : nullptr;
+	int v = reg ? (int)*reg : -1;
+	const int err = sysctl_handle_int(oidp, &v, 0, req);
+	if (err || !req->newptr) return err;
+	if (!reg || v < 0 || v > 0x3FFFFF) return EINVAL;
+	*reg = (uint32_t)v;
+	return 0;
+}
+SYSCTL_PROC(_debug, OID_AUTO, wexltrign, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, nullptr, 0, wexLtrIgnSysctl, "I", "PMC LTR ignore mask (bit 4 = XHCI)");
+// XCPM core C-state table (2026-11-15, PC10 investigation). _xcpm_idle picks, from *_xcpm_cstate_table (20 entries of
+// 24 bytes: u32 name (1000 = C10 .. 100 = C0), u32 MWAIT hint, u32 enabled, u32 pad, u64 threshold ns), the deepest
+// enabled entry whose threshold is <= the time to this CPU's next deadline (kernel 25.6.0, _xcpm_idle+0x178..0x1cb).
+// "WhateverXeXcpmCst" publishes the live table; sysctl debug.wexc10lat / wexc9lat read or set (us) the threshold of the
+// C10 (0x60) / C9 (0x50) entry. Nothing is written until a sysctl is written; a reboot restores the kernel's values.
+static uint8_t **wexXcpmCst;
+static volatile uint64_t *wexXcpmCstLat(uint32_t name, uint32_t hint) {
+	if (!wexXcpmCst) return nullptr;
+	auto t = *wexXcpmCst;
+	if (reinterpret_cast<uintptr_t>(t) < 0xFFFFFF8000000000ULL) return nullptr;
+	for (int i = 0; i < 20; i++) {
+		auto e = t + i * 24;
+		const uint32_t n = *reinterpret_cast<uint32_t *>(e), h = *reinterpret_cast<uint32_t *>(e + 4);
+		if (n == name && h == hint) return reinterpret_cast<volatile uint64_t *>(e + 0x10);
+		if (n == 100) break;
+	}
+	return nullptr;
+}
+static int wexCstLatSysctl SYSCTL_HANDLER_ARGS {
+	const uint32_t name = (uint32_t)arg2, hint = name == 1000 ? 0x60 : 0x50;
+	auto lat = wexXcpmCstLat(name, hint);
+	int v = lat ? (int)(*lat / 1000) : -1;
+	const int err = sysctl_handle_int(oidp, &v, 0, req);
+	if (err || !req->newptr) return err;
+	if (!lat || v < 20 || v > 100000) return EINVAL;
+	*lat = (uint64_t)v * 1000;
+	return 0;
+}
