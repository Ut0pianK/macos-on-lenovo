+static uint64_t wexPsr1Now() { uint64_t t, ns; clock_get_uptime(&t); absolutetime_to_nanoseconds(t, &ns); return ns; }
+// Enable and disable are serialised by a spin lock with interrupts off: both are a handful of register accesses.
+static void wexDcOff(uint32_t why);
+static void wexDc6AutoOff();
+static void wexDcOffHook(uint32_t why) { wexDcOff(0x100 | why); }
+static void wexPsr1Stop(uint32_t reason) {
+	bool was = false;
+	if (!wexPsr1Lock) return;
+	const auto st = IOSimpleLockLockDisableInterrupt(wexPsr1Lock);
+	if (wexPsr1Phase == 2) {
