+// sysctl debug.wexepp (2026-11-14): the EPP macOS's own power management (XCPM) uses as its base value.
+//  XCPM stores the "epp" key of the board's FrequencyVectors in the byte at *(_xcpm_qos_table)+0x94 and raises
+//  _xcpm_hwp_idle_epp to at least that (kernel 25.6.0, _xcpm_cpu_control+0x1fa0). Writing 1..255 here stores the byte
+//  the same way; reading returns it. The symbols are solved by name; the first write is refused unless the byte still
+//  holds the value read at start (so a kernel with a different layout is never written).
+static uint8_t **wexXcpmQos; static uint8_t *wexXcpmIdleEpp; static int wexEppOrig = -1;
+static uint8_t *wexEppSlot() {
+	if (!wexXcpmQos) return nullptr;
+	auto t = *wexXcpmQos;
+	return reinterpret_cast<uintptr_t>(t) >= 0xFFFFFF8000000000ULL ? t + 0x94 : nullptr;
+}
+static int wexEppSysctl SYSCTL_HANDLER_ARGS {
+	auto slot = wexEppSlot();
+	int v = slot ? *slot : -1;
+	const int err = sysctl_handle_int(oidp, &v, 0, req);
+	if (err || !req->newptr) return err;
+	if (!slot || !wexXcpmIdleEpp || v < 1 || v > 255) return EINVAL;
+	if (wexEppOrig < 0) wexEppOrig = *slot;
+	*slot = (uint8_t)v;
+	if (*wexXcpmIdleEpp < (uint8_t)v) *wexXcpmIdleEpp = (uint8_t)v;      // as XCPM's own handler does
