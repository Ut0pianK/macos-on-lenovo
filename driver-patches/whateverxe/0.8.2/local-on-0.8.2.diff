+		UInt32 x = 0;
+		if (pc->validateObject("TCOF") == kIOReturnSuccess) v |= 1;
+		if (pc->validateObject("TCON") == kIOReturnSuccess) v |= 2;
+		if (pc->evaluateInteger("TD3C", &x) == kIOReturnSuccess && x) v |= 4;
+		pc->release();
+	} else v = -1;
