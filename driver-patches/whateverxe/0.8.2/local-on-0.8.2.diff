+// index/value pair is never interleaved with the driver's. debug.wexctia=0 turns it off.
+static int wexCtia = 1;
+static void *wexCtiaThat;
+static volatile bool wexHpPresent;
+static uint16_t wexCoefIdx = 0xFFFF;
+static thread_call_t wexCtiaCall;
