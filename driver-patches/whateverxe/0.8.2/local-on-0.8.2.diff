+static int wexL1ssSysctl SYSCTL_HANDLER_ARGS {
+	int v = wexL1ss;
+	const int err = sysctl_handle_int(oidp, &v, 0, req);
+	if (err || !req->newptr) return err;
+	if (v < 0 || v > 3 || !wexL1ssCall) return EINVAL;
+	wexL1ss = v; thread_call_enter(wexL1ssCall);
+	return 0;
+}
+SYSCTL_PROC(_debug, OID_AUTO, wexl1ss, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, nullptr, 0, wexL1ssSysctl, "I", "PCIe L1 substates: bit0 SD reader, bit1 NVMe");
+static bool wexL1ssStatSerialize(void *, void *, OSSerialize *serializer) {
+	auto out = OSData::withBytes(wexL1ssStat, sizeof(wexL1ssStat)); if (!out) return false;
