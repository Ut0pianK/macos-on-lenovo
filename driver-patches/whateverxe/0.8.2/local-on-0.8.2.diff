+static uint32_t wexPmcExt(IOPCIDevice *d, uint32_t id) {
+	// extended capability walk, bounded
+	uint32_t off = 0x100;
+	for (int i = 0; i < 48 && off >= 0x100 && off < 0xFFC; i++) {
+		const uint32_t h = d->extendedConfigRead32(off);
+		if (h == 0 || h == 0xFFFFFFFF) return 0;
+		if ((h & 0xFFFF) == id) return off;
+		off = (h >> 20) & 0xFFC;
+	}
+	return 0;
+}
+static void wexPmcScan(thread_call_param_t, thread_call_param_t) {
+	uint32_t n = 0;
+	if (auto it = IORegistryIterator::iterateOver(gIOServicePlane, kIORegistryIterateRecursively)) {
+		while (auto e = it->getNextObject()) {
+			auto d = OSDynamicCast(IOPCIDevice, e);
+			if (!d || n >= arrsize(wexPmcPci)) continue;
+			const uint32_t id = d->configRead32(0);
+			if ((id & 0xFFFF) == 0xFFFF || (id & 0xFFFF) == 0) continue;      // powered off or absent
+			auto q = wexPmcPci[n];
+			q[0] = (uint64_t)d->getBusNumber() << 48 | (uint64_t)d->getDeviceNumber() << 40 | (uint64_t)d->getFunctionNumber() << 32 | id;
+			q[1] = d->configRead32(8);                                             // class / revision
+			uint8_t off = 0; q[2] = q[3] = q[4] = q[5] = q[6] = q[7] = 0;
+			if (d->findPCICapability(0x10, &off) && off) {
+				q[2] = (uint64_t)d->configRead32(off + 0x10) << 32 | d->configRead32(off + 0x0C);   // LNKCTL/STA : LNKCAP
+				q[3] = (uint64_t)d->configRead32(off + 0x28) << 32 | d->configRead32(off + 0x24);   // DEVCTL2/STA2 : DEVCAP2
+			}
+			off = 0;
+			if (d->findPCICapability(0x01, &off) && off) q[4] = d->configRead32(off + 4) | (uint64_t)off << 32;   // PMCSR
+			if (const uint32_t l1 = wexPmcExt(d, 0x1E)) {
+				q[5] = (uint64_t)d->extendedConfigRead32(l1 + 8) << 32 | d->extendedConfigRead32(l1 + 4);     // L1SS CTL1 : CAP
+				q[6] = d->extendedConfigRead32(l1 + 0xC);                                                   // L1SS CTL2
+			}
