+static int wexEpb = -1;
+static void wexEpbApply(void *arg) {
+	const uint32_t v = *static_cast<uint32_t *>(arg);
+	uint32_t lo, hi; asm volatile("rdmsr" : "=a"(lo), "=d"(hi) : "c"(0x1B0));
+	lo = (lo & ~0xFU) | (v & 0xF);
+	asm volatile("wrmsr" : : "a"(lo), "d"(hi), "c"(0x1B0));
+}
+static bool wexEpbSupported() { uint32_t a, b, c, d; asm volatile("cpuid" : "=a"(a), "=b"(b), "=c"(c), "=d"(d) : "a"(6), "c"(0)); return (c >> 3) & 1; }
