+    nvSafari = checkKernelArgument("-wex-nvsafari");
+    nvAny = checkKernelArgument("-wex-nvmtl-lv");
+    IORegistryEntry::getRegistryRoot()->setProperty("WhateverXeNvmtlLV", nvAny);
+    // -wex-vp9 (with -wex-vpfix, as the user patches require): waive library validation for vp9stack.dylib in WebKit GPU.
+    vp9Lv = checkKernelArgument("-wex-vp9") && checkKernelArgument("-wex-vpfix");
+    IORegistryEntry::getRegistryRoot()->setProperty("WhateverXeVp9LV", vp9Lv);
