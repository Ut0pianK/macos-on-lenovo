+static volatile uint32_t *wexPsr1Reg(uint32_t off) {
+	if (!wexPsr1Bar) if (auto gpu = wexPsrGPU()) wexPsr1Bar = gpu->mapDeviceMemoryWithRegister(kIOPCIConfigBaseAddress0);
+	if (!wexPsr1Bar || off + 4 > wexPsr1Bar->getLength()) return nullptr;
