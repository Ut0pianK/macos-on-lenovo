+	auto w = wr(port, 0x170, &v, 1);
+	if (!w) { v |= 0x01; w = wr(port, 0x170, &v, 1); }
+	wexPsr1SinkResult = w; __atomic_fetch_add(&wexPsr1SinkWrites, 1, __ATOMIC_RELAXED);
+	__atomic_store_n(&wexPsr1EventNs, wexPsr1Now(), __ATOMIC_RELEASE);
+	__atomic_store_n(&wexPsr1SinkOK, w ? 0 : 1, __ATOMIC_RELEASE);
