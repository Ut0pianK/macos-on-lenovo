+static void tick(thread_call_param_t param0, thread_call_param_t) {
+	auto &job = *static_cast<Job *>(param0);
+	int pid = atomic_load(&job.pid);
+	int res = -2;
+	proc_t p = pid > 0 ? proc_find(pid) : nullptr;
+	if (p) {
+		char name[32] {};
+		proc_name(pid, name, sizeof(name));
+		task_t task = !strcmp(name, "Safari") ? procTask(p) : nullptr;
+		vm_map_t map = task ? getTaskMapRef(task) : nullptr;
+		mach_vm_address_t infos = task ? taskImageInfo(task) : 0;
+		res = map ? (infos ? tryPatch(job, map, infos) : 1) : -2;
+		if (map)
+			vmMapDeallocate(map);
+		proc_rele(p);
+	}
+
+	if (res == 1 && ++job.ticks < maxTicks) {
+		uint64_t deadline;
+		clock_interval_to_deadline(tickMs, kMillisecondScale, &deadline);
+		thread_call_enter_delayed(job.call, deadline);
+		return;
+	}
+
+	if (res == 1)
+		res = -2;
+	statLast = res == 0 ? 1 : res;
+	if (res == 0)
+		statPatched++;
+	SYSLOG("wex", "safarilist: pid %d %s (%d) after %u ticks", pid, res == 0 ? "patched" : res == 2 ? "already patched" : "not patched", res, job.ticks);
+	atomic_store(&job.pid, 0);
+}
