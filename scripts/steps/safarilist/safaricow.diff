+static bool endsWith(const char *s, size_t len, const char *suffix) {
+	size_t n = strlen(suffix);
+	return len >= n && !strncmp(s + len - n, suffix, n);
+}
+
+static bool readUser(vm_map_t map, mach_vm_address_t addr, void *dst, size_t size) {
+	return addr != 0 && vmMapReadUser(map, addr, dst, size) == KERN_SUCCESS;
+}
+
+// Reads a NUL-terminated string of up to size - 1 bytes without touching the page after its end.
+static bool readUserString(vm_map_t map, mach_vm_address_t addr, char *buf, size_t size) {
+	memset(buf, 0, size);
+	size_t done = 0;
+	while (done < size - 1) {
+		size_t chunk = PAGE_SIZE - ((addr + done) & PAGE_MASK);
+		if (chunk > size - 1 - done)
+			chunk = size - 1 - done;
+		if (!readUser(map, addr + done, buf + done, chunk))
+			return false;
+		if (memchr(buf + done, 0, chunk))
+			return true;
+		done += chunk;
+	}
+	return true;
+}
+
+static bool userStringIs(vm_map_t map, mach_vm_address_t addr, const char *want) {
+	char buf[32];
+	size_t n = strlen(want) + 1;
+	return n <= sizeof(buf) && readUserString(map, addr, buf, sizeof(buf)) && !memcmp(buf, want, n);
+}
+
+// Load address of Safari.framework from dyld_all_image_infos (version, count, infoArray), 0 if not there yet.
+static mach_vm_address_t findImage(vm_map_t map, mach_vm_address_t infos) {
+	struct { uint32_t version, count; uint64_t array; } head {};
+	if (!readUser(map, infos, &head, sizeof(head)) || head.array == 0 || head.count == 0 || head.count > 4096)
+		return 0;
+	struct Entry { uint64_t load, path, date; };
+	Entry batch[32];
+	for (uint32_t i = 0; i < head.count; i += arrsize(batch)) {
+		uint32_t n = head.count - i < arrsize(batch) ? head.count - i : (uint32_t)arrsize(batch);
+		if (!readUser(map, head.array + i * sizeof(Entry), batch, n * sizeof(Entry)))
+			return 0;
+		for (uint32_t k = 0; k < n; k++) {
+			char path[160];
+			if (!batch[k].load || !readUserString(map, batch[k].path, path, sizeof(path)))
+				continue;
+			if (endsWith(path, strnlen(path, sizeof(path)), imageSuffix))
+				return batch[k].load;
+		}
+	}
+	return 0;
+}
