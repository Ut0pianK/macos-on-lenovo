+static int execListener(kauth_cred_t, void *idata, kauth_action_t action, uintptr_t, uintptr_t arg1, uintptr_t, uintptr_t) {
+	if (idata != &cookie || action != KAUTH_FILEOP_EXEC || !arg1)
+		return KAUTH_RESULT_DEFER;
+	auto path = reinterpret_cast<const char *>(arg1);
+	if (!endsWith(path, strlen(path), execSuffix))
+		return KAUTH_RESULT_DEFER;
+
+	int pid = proc_selfpid();
+	for (auto &job : jobs) {
+		int expected = 0;
+		if (atomic_compare_exchange_strong(&job.pid, &expected, pid)) {
+			job.ticks = 0;
+			job.ready = false;
+			uint64_t deadline;
+			clock_interval_to_deadline(tickMs, kMillisecondScale, &deadline);
+			thread_call_enter_delayed(job.call, deadline);
+			return KAUTH_RESULT_DEFER;
+		}
+	}
+	statLast = -6;
+	return KAUTH_RESULT_DEFER;
+}
