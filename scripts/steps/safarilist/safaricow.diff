+static bool uuidMatches(vm_map_t map, mach_vm_address_t base) {
+	struct { uint32_t magic, cputype, cpusubtype, filetype, ncmds, sizeofcmds, flags, reserved; } mh {};
+	if (!readUser(map, base, &mh, sizeof(mh)) || mh.magic != 0xfeedfacf || mh.cputype != CPU_TYPE_X86_64 ||
+		mh.sizeofcmds == 0 || mh.sizeofcmds > 0x10000)
+		return false;
+	auto cmds = static_cast<uint8_t *>(IOMalloc(mh.sizeofcmds));
+	if (!cmds)
+		return false;
+	bool ok = false;
+	if (readUser(map, base + sizeof(mh), cmds, mh.sizeofcmds)) {
+		for (uint32_t off = 0, i = 0; i < mh.ncmds && off + 8 <= mh.sizeofcmds; i++) {
+			uint32_t cmd = *reinterpret_cast<uint32_t *>(cmds + off), size = *reinterpret_cast<uint32_t *>(cmds + off + 4);
+			if (size < 8 || off + size > mh.sizeofcmds)
+				break;
+			if (cmd == 0x1b /* LC_UUID */ && size >= 24) {
+				ok = !memcmp(cmds + off + 8, imageUuid, sizeof(imageUuid));
+				break;
+			}
+			off += size;
+		}
+	}
+	IOFree(cmds, mh.sizeofcmds);
+	return ok;
+}
 
+// 0 done, 1 try again later, <0 give up (statLast code).
+static int tryPatch(Job &job, vm_map_t map, mach_vm_address_t infos) {
+	mach_vm_address_t base = findImage(map, infos);
+	if (!base)
+		return 1;
+	if (!uuidMatches(map, base))
+		return -1;
+
+	uint64_t glass = 0, proxy = 0;
+	if (!readUser(map, base + glassSelRef, &glass, sizeof(glass)) || !readUser(map, base + proxySelRef, &proxy, sizeof(proxy)))
+		return 1;
+	// Until the selectors are uniqued, isProxy points into Safari's own __objc_methname.
+	if (proxy == 0 || (proxy >= base && proxy < base + imageSize))
+		return 1;
+	if (!userStringIs(map, proxy, "isProxy"))
+		return 1;
+	if (glass == proxy)
+		return 2;
+	if (!userStringIs(map, glass, "shouldUseGlassBackdropView"))
+		return job.ticks + 1 >= maxTicks ? -7 : 1;
+	// Seen ready once: give objc one more tick to finish the image before writing.
+	if (!job.ready) {
+		job.ready = true;
+		return 1;
+	}
+
+	mach_vm_address_t slot = base + glassSelRef, page = slot & ~(mach_vm_address_t)PAGE_MASK;
+	if (machVmProtect(map, page, PAGE_SIZE, FALSE, VM_PROT_READ | VM_PROT_WRITE) != KERN_SUCCESS)
+		return -3;
+	kern_return_t wr = vmMapWriteUser(map, &proxy, slot, sizeof(proxy));
+	kern_return_t pr = machVmProtect(map, page, PAGE_SIZE, FALSE, VM_PROT_READ);
+	if (wr != KERN_SUCCESS)
+		return -4;
+	uint64_t check = 0;
+	if (!readUser(map, slot, &check, sizeof(check)) || check != proxy)
+		return -5;
+	SYSLOG_COND(pr != KERN_SUCCESS, "wex", "safarilist: restoring read-only protection failed (%d)", pr);
+	return 0;
+}
