+static constexpr uint64_t glassSelRef {0xc39aa0};  // shouldUseGlassBackdropView
+static constexpr uint64_t proxySelRef {0xc21468};  // isProxy
+static constexpr uint64_t imageSize {0xc94000};    // __TEXT .. __DATA_DIRTY end (vmaddr 0 based)
