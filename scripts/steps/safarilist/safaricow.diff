+static void onPatcher(void *, KernelPatcher &patcher) {
+	auto solve = [&patcher](const char *name) {
+		auto addr = patcher.solveSymbol(KernelPatcher::KernelID, name);
+		if (!addr) {
+			SYSLOG("wex", "safarilist: %s not found", name);
+			patcher.clearError();
+		}
+		return addr;
+	};
+	procTask = reinterpret_cast<t_procTask>(solve("_proc_task"));
+	getTaskMapRef = reinterpret_cast<t_getTaskMapRef>(solve("_get_task_map_reference"));
+	vmMapDeallocate = reinterpret_cast<t_vmMapDeallocate>(solve("_vm_map_deallocate"));
+	vmMapReadUser = reinterpret_cast<t_vmMapReadUser>(solve("_vm_map_read_user"));
+	vmMapWriteUser = reinterpret_cast<t_vmMapWriteUser>(solve("_vm_map_write_user"));
+	machVmProtect = reinterpret_cast<t_machVmProtect>(solve("_mach_vm_protect"));
+	taskImageInfo = reinterpret_cast<t_taskImageInfo>(solve("_task_get_all_image_info_addr"));
+	if (!procTask || !getTaskMapRef || !vmMapDeallocate || !vmMapReadUser || !vmMapWriteUser || !machVmProtect || !taskImageInfo)
+		return;
+
+	for (auto &job : jobs) {
+		if (!(job.call = thread_call_allocate(tick, &job))) {
+			SYSLOG("wex", "safarilist: thread_call_allocate failed");
+			return;
+		}
+	}
+	sysctl_register_oid(&sysctl__debug_wexsafarilist);
+	sysctl_register_oid(&sysctl__debug_wexsafarilist_last);
+	listener = kauth_listen_scope(KAUTH_SCOPE_FILEOP, execListener, &cookie);
+	SYSLOG("wex", "safarilist: %s", listener ? "watching Safari launches (per-process selector redirect)" : "kauth_listen_scope failed");
+}
